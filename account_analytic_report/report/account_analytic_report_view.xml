<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_invoice_report_search_inherit" model="ir.ui.view">
        <field name="name">account.invoice.report.search.inherit</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_categ_id']" position="after">
                <field name="analytic_account_id"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Conta Analítica" name="analytic" context="{'group_by':'analytic_account_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>