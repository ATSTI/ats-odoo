<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_service_template">
    <t t-call="web.external_layout">
      <t t-foreach="docs" t-as="doc">
        <style>
          * { margin:0; padding:0; box-sizing:border-box; font-family: Arial, sans-serif; text-transform: uppercase; }
          .page { width:100%; padding:15px; }
          .company { width:100%; border-collapse: collapse; margin-bottom:15px; }
          .logo { width:20%; text-align:center; vertical-align: top; }
          .logo img { max-width:150px; max-height:80px; display:block; margin:auto; }
          .address { width:50%; border: thin solid black; padding:8px; font-size:12px; vertical-align: top; }
          .shipping { width:28%; border: thin solid black; padding:8px; font-size:12px; vertical-align: top; }
          .data_receipt, .client, .service { width:100%; border-collapse: collapse; margin-bottom:10px; font-size:12px; }
          .data_receipt td, .client td, .service td { border: thin solid black; padding: 6px; text-align:center; }
          .client td { text-align:left; }
          .service th { background-color:#f2f2f2; font-weight:bold; padding:6px; }
          #total td { padding:6px; font-weight:bold; }
          .message { width:100%; font-size:10px; border: thin solid black; padding:6px; margin:5px 0; }
          .dashed { width:100%; border:1px dashed; margin:8px 0; }
          .signature td { border: thin solid black; padding:5px; font-size:11px; vertical-align: top; }
        </style>

        <main>
          <div class="page">
            <table class="company">
              <tr>
                <td style="width:40%; vertical-align:top; padding:0; text-align:center;">
                    <img t-attf-src="data:image/png;base64,{{doc.company_id.logo}}"
                        t-att-alt="doc.company_id.name"
                        style="max-width:300px; max-height:90px; display:inline-block;"/>
                </td>
                <td class="address">
                  <strong t-field="doc.company_id.name"></strong><br/>
                  <span t-field="doc.company_id.street_name"></span>, <span t-field="doc.company_id.street_number"></span> - <span t-field="doc.company_id.district"></span><br/>
                  CEP: <span t-field="doc.company_id.zip"></span> - <span t-field="doc.company_id.city_id"></span> - <span t-field="doc.company_id.state_id.code"></span><br/>
                  Fones: <span t-field="doc.company_id.phone"></span>
                </td>
                <td class="shipping">
                  <strong>RECIBO Nº:</strong> <span t-field="doc.name"></span><br/>
                  CNPJ: <span t-field="doc.company_id.cnpj_cpf"></span><br/>
                  Insc. Municipal: <span t-field="doc.company_id.inscr_mun"></span><br/>
                  Insc. Estadual: <span t-field="doc.company_id.inscr_est"></span><br/>
                  Emissão: <span t-field="doc.invoice_date"></span>
                </td>
              </tr>
            </table>
            <table class="data_receipt">
              <tr>
                <td>Nº FATURA</td>
                <td>VALOR R$</td>
                <td>DUPLICATA</td>
                <td>VENCIMENTO</td>
                <td>RECIBO</td>
              </tr>
              <tr>
                <td><span t-field="doc.name"></span></td>
                <td><span t-field="doc.amount_total"></span></td>
                <td><span t-field="doc.ref"></span></td>
                <td><span t-field="doc.invoice_date_due"></span></td>
                <td><span t-field="doc.ref"></span></td>
              </tr>
            </table>
            <table class="client">
              <tr><td colspan="3"><strong>Nome do Sacado:</strong> <span t-field="doc.partner_id.name"></span></td></tr>
              <tr>
                <td><strong>Endereço:</strong> <span t-field="doc.partner_id.street"></span></td>
                <td><strong>Bairro:</strong> <span t-field="doc.partner_id.district"></span></td>
                <td><strong>Município:</strong> <span t-field="doc.partner_id.city_id"></span></td>
              </tr>
              <tr>
                <td><strong>CEP:</strong> <span t-field="doc.partner_id.zip"></span></td>
                <td><strong>Estado:</strong> <span t-field="doc.partner_id.state_id"></span></td>
                <td><strong>CNPJ/CPF:</strong> <span t-field="doc.partner_id.cnpj_cpf"></span></td>
              </tr>
            </table>
            <table class="service">
              <tr>
                <th>UNIDADE</th>
                <th>QTD</th>
                <th>DISCRIMINAÇÃO DOS SERVIÇOS</th>
                <th>UNITÁRIO</th>
                <th>TOTAL</th>
              </tr>
              <t t-foreach="doc.invoice_line_ids" t-as="line">
                <tr>
                  <td><span t-field="line.uom_id.code"></span></td>
                  <td><span t-field="line.quantity"></span></td>
                  <td><span t-field="line.name"></span></td>
                  <td><span t-field="line.price_unit"></span></td>
                  <td><span t-field="line.price_subtotal"></span></td>
                </tr>
              </t>
              <tr>
                <td colspan="4">Valor Frete</td>
                <td><span t-field="doc.amount_freight_value"></span></td>
              </tr>
              <tr>
                <td colspan="4">VALOR TOTAL</td>
                <td><span t-field="doc.amount_total"></span></td>
              </tr>
            </table>
            <div class="message">
              A importância desta fatura corresponde à prestação de serviços discriminados acima.
              Pagamento deve ser feito a <span t-field="doc.company_id.name"></span>.
            </div>

            <div class="dashed"></div>
            <table class="signature">
              <tr>
                <td style="width:50%">Recebi(emos) de <strong t-field="doc.company_id.name"></strong> os serviços acima.</td>
                <td>RECIBO Nº: <span t-field="doc.ref"></span></td>
              </tr>
              <tr>
                <td>Data do Recebimento: ________</td>
                <td>Assinatura: _____________________</td>
              </tr>
            </table>

            <div style="margin-top:10px; font-size:8px; color:#5c5c5c">
              Powered By ATSTi Soluções - www.atsti.com.br
            </div>

          </div>
        </main>
      </t>
    </t>
  </template>
</odoo>
