<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="view_move_form_inherit_partner_website" model="ir.ui.view">
      <field name="name">account.move.form.inherit.partner.website</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_move_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='partner_id']" position="after">
          <label for="partner_website" attrs="{'invisible': [('move_type','not in', ['out_invoice','out_refund'])]}"/>
          <div attrs="{'invisible': [('move_type','not in', ['out_invoice','out_refund'])]}">
            <field name="partner_website" widget="url" readonly="1"/>
          </div>
        </xpath>
      </field>
    </record>
  </data>
</odoo>