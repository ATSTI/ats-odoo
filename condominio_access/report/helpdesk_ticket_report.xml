<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ação de Report -->
    <record id="action_report_helpdesk_ticket" model="ir.actions.report">
        <field name="name">Chamado de Helpdesk</field>
        <field name="model">helpdesk.ticket</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">condominio_access.report_helpdesk_ticket_document</field>
        <field name="report_file">condominio_access.report_helpdesk_ticket_document</field>
        <field name="print_report_name">'Chamado - %s' % (object.number)</field>
        <field name="binding_model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template do Report -->
    <template id="report_helpdesk_ticket_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Arial, sans-serif; color: #2b2b2b;">

                        <!-- Cabeçalho do chamado -->
                        <div style="background-color: #34495e; color: #ffffff; padding: 14px 20px; border-radius: 4px 4px 0 0;">
                            <table style="width: 100%; border: none;">
                                <tr>
                                    <td style="border: none; vertical-align: middle;">
                                        <h2 style="margin: 0; color: #ffffff; font-size: 20px; letter-spacing: 0.5px;">
                                            CHAMADO DE HELPDESK
                                        </h2>
                                        <span style="font-size: 12px; color: #d6dce5;" t-esc="doc.name"/>
                                    </td>
                                    <td style="border: none; text-align: right; vertical-align: middle;">
                                        <span style="font-size: 11px; color: #bfc9d4; text-transform: uppercase;">Número</span><br/>
                                        <span style="font-size: 22px; font-weight: bold; color: #ffffff;" t-esc="doc.number"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Faixa de informações rápidas -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 18px; border: 1px solid #dcdfe3; border-top: none;">
                            <tr>
                                <td style="width: 25%; background-color: #f4f6f8; padding: 8px 12px; border-right: 1px solid #dcdfe3; font-size: 10px; color: #6b7280; text-transform: uppercase;">Data do Chamado</td>
                                <td style="width: 25%; padding: 8px 12px; border-right: 1px solid #dcdfe3; font-size: 12px; font-weight: bold;">
                                    <span t-field="doc.create_date" t-options="{'widget': 'date'}"/>
                                </td>
                                <td style="width: 25%; background-color: #f4f6f8; padding: 8px 12px; border-right: 1px solid #dcdfe3; font-size: 10px; color: #6b7280; text-transform: uppercase;">Prioridade</td>
                                <td style="width: 25%; padding: 8px 12px; font-size: 12px; font-weight: bold;">
                                    <span t-field="doc.priority"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="background-color: #f4f6f8; padding: 8px 12px; border-right: 1px solid #dcdfe3; border-top: 1px solid #dcdfe3; font-size: 10px; color: #6b7280; text-transform: uppercase;">Situação</td>
                                <td style="padding: 8px 12px; border-right: 1px solid #dcdfe3; border-top: 1px solid #dcdfe3; font-size: 12px; font-weight: bold;">
                                    <span t-field="doc.stage_id"/>
                                </td>
                                <td style="background-color: #f4f6f8; padding: 8px 12px; border-right: 1px solid #dcdfe3; border-top: 1px solid #dcdfe3; font-size: 10px; color: #6b7280; text-transform: uppercase;">Responsável</td>
                                <td style="padding: 8px 12px; border-top: 1px solid #dcdfe3; font-size: 12px; font-weight: bold;">
                                    <span t-field="doc.user_id"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Dados do Parceiro -->
                        <h4 style="color: #34495e; border-bottom: 2px solid #34495e; padding-bottom: 4px; margin-bottom: 10px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">
                            Dados do Parceiro
                        </h4>
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                            <tr>
                                <td style="width: 50%; padding: 4px 12px 4px 0; vertical-align: top;">
                                    <span style="font-size: 10px; color: #6b7280; text-transform: uppercase;">Nome</span><br/>
                                    <span style="font-size: 12px;" t-field="doc.partner_id.name"/>
                                </td>
                                <td style="width: 50%; padding: 4px 0; vertical-align: top;">
                                    <span style="font-size: 10px; color: #6b7280; text-transform: uppercase;">CNPJ/CPF</span><br/>
                                    <span style="font-size: 12px;" t-field="doc.partner_id.vat"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px 12px 4px 0; vertical-align: top;">
                                    <span style="font-size: 10px; color: #6b7280; text-transform: uppercase;">Telefone</span><br/>
                                    <span style="font-size: 12px;" t-field="doc.partner_id.phone"/>
                                </td>
                                <td style="padding: 8px 0 4px 0; vertical-align: top;">
                                    <span style="font-size: 10px; color: #6b7280; text-transform: uppercase;">E-mail</span><br/>
                                    <span style="font-size: 12px;" t-field="doc.partner_id.email"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Observações -->
                        <h4 style="color: #34495e; border-bottom: 2px solid #34495e; padding-bottom: 4px; margin-bottom: 10px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">
                            Observações
                        </h4>
                        <div style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 4px; padding: 12px 14px; font-size: 12px; min-height: 60px;">
                            <span t-raw="doc.description"/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>