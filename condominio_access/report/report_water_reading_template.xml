<odoo>
    <template id="report_water_reading_template">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <t t-set="company" t-value="env.company"/>
                <style>
                    @page {
                        margin-top: 35px;
                        margin-bottom: 30px;
                    }

                    .header {
                        width: 100%;
                        margin-bottom: 20px;
                    }

                    .page {
                        padding-top: 10px;
                    }

                    h2 {
                        text-align: center;
                        margin-bottom: 20px;
                        font-size: 18px;
                    }

                    table.water_table {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 10px;
                    }

                    table.water_table th {
                        background-color: #f2f2f2;
                        border: 1px solid #ccc;
                        padding: 6px;
                        text-align: center;
                        font-weight: bold;
                    }

                    table.water_table td {
                        border: 1px solid #ddd;
                        padding: 5px;
                        vertical-align: middle;
                    }

                    thead {
                        display: table-header-group;
                    }

                    tr {
                        page-break-inside: avoid;
                    }

                    .resumo-final {
                        margin-top: 20px;
                        width: 35%;
                        float: right;
                        font-size: 11px;
                    }

                    .resumo-final table {
                        width: 100%;
                        border-collapse: collapse;
                    }

                    .resumo-final td {
                        border: 1px solid #999;
                        padding: 6px;
                    }
                </style>
                <div class="page">
                    <h2>Relatório de Leituras de Água</h2>
                    <t t-set="total_consumo" t-value="0"/>
                    <t t-set="total_valor" t-value="0"/>
                    <table class="water_table">
                        <thead>
                            <tr>
                                <th>Residência</th>
                                <th>Referência</th>
                                <th>Anterior</th>
                                <th>Atual</th>
                                <th>Consumo</th>
                                <th>Valor</th>
                                <th>Obs.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="leitura">

                                <t t-if="leitura.exists()">

                                    <t t-set="obs_limpa"
                                       t-value="(leitura.obs or '').strip().lower()"/>

                                    <t t-set="valor_calculado"
                                       t-value="(leitura.consumo or 0) * metro"/>

                                    <t t-set="valor_final"
                                       t-value="0 if obs_limpa == 'sem hidro' else (35 if valor_calculado &lt; 35 else valor_calculado)"/>

                                    <t t-set="total_consumo"
                                       t-value="total_consumo + (0 if obs_limpa == 'sem hidro' else (leitura.consumo or 0))"/>

                                    <t t-set="total_valor"
                                       t-value="total_valor + valor_final"/>
                                    <tr>
                                        <td>
                                            <span t-field="leitura.residence_id"/>
                                        </td>

                                        <td>
                                            <span t-field="leitura.data_referencia"/>
                                        </td>

                                        <td>
                                            <span t-field="leitura.anterior"/>
                                        </td>

                                        <td>
                                            <span t-field="leitura.atual"/>
                                        </td>

                                        <td>
                                            <span t-field="leitura.consumo"/> m³
                                        </td>

                                        <td>
                                            <t t-if="obs_limpa != 'sem hidro'">
                                                R$ <t t-esc="'%.2f' % valor_final"/>
                                            </t>
                                            <t t-else="">-</t>
                                        </td>

                                        <td>
                                            <t t-esc="leitura.obs or '-'"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                    <div style="clear: both;"></div>
                    <div class="resumo-final">
                        <table>
                            <tr>
                                <td><strong>Total consumido</strong></td>
                                <td>
                                    <strong>
                                        <t t-esc="'%.2f' % total_consumo"/> m³
                                    </strong>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Total geral</strong></td>
                                <td>
                                    <strong>
                                        R$ <t t-esc="'%.2f' % total_valor"/>
                                    </strong>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>