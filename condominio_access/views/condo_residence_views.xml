<odoo>
    <record id="view_condo_residence_kanban" model="ir.ui.view">
        <field name="name">condo.residence.kanban</field>
        <field name="model">condo.residence</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="true" quick_create="false">
                <field name="name"/>
                <field name="rua"/>
                <field name="lote"/>
                <field name="numero"/>
                <field name="moradores"/>
                <field name="tipo"/>
                <field name="image_1920"/>
                <field name="active"/>
                <field name="leitura_agua_ids" invisible="1"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card shadow-sm rounded overflow-hidden"
                             style="width:260px;">

                           <div class="text-center mb-3">
                                <field name="image_1920"
                                    widget="image"
                                    class="oe_avatar"
                                    options="{'preview_image': 'image_1920'}"
                                    style="max-width:100%; max-height:220px; object-fit:cover;"/>                            </div>

                            <div class="p-2">
                                <strong class="d-block text-truncate">
                                    <field name="name"/>
                                </strong>

                                <div class="text-muted small">
                                    <field name="rua"/> - <field name="numero"/>
                                </div>

                                <div class="mt-1 small">
                                    👥 <field name="moradores"/> moradores
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="badge bg-primary">
                                        <field name="tipo"/>
                                    </span>

                                    <field name="active" widget="boolean_toggle"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_condo_residence_form" model="ir.ui.view">
        <field name="name">condo.residence.form</field>
        <field name="model">condo.residence</field>
        <field name="arch" type="xml">
            <form string="Residência">
                <header>
                <button name="action_compute_name"
                        string="Recalcular Nomes (Lote - Proprietário)"
                        type="object"
                        class="btn btn-secondary"/>
            </header>
                <sheet>

                    <div style="width:100%; height:100px; overflow:hidden; border-radius:8px;">
                        <field name="image_1920"
                                    widget="image"
                                    class="oe_avatar"
                                    options="{'preview_image': 'image_1920'}"
                                    style="width:100%; height:100%; object-fit:cover;"/>
                    </div>

                    <div class="oe_title mt-3">
                        <h1>
                            <field name="name" placeholder="Nome da residência"/>
                        </h1>
                    </div>

                    <group col="2">
                        <group string="Endereço">
                            <field name="rua"/>
                            <field name="numero"/>
                            <field name="lote"/>
                        </group>

                        <group string="Detalhes">
                            <field name="tipo"/>
                            <field name="moradores" readonly="1"/>
                            <field name="active"/>
                        </group>

                        <group string="Inquilino e Proprietário">
                            <field name="inquilino_id"/>
                            <field name="coproprietario_id"/>
                            <field name="proprietario_id"/>
                        </group>
                    </group>

                    <group string="Visitantes recorrentes" name ="visitantes_recorrentes_page">
                        <field name="visitantes_recorrentes_ids">
                            <tree editable="bottom">
                                <field name="partner_id"/>
                                <field name="expediente"/>
                            </tree>
                        </field>
                    </group>

                    <notebook>

                        <page string="Moradores" name='moradores_page'>
                            <field name="partner_ids"/>
                        </page>

                        <page string="Leitura de Água" name ="leitura_agua_page">
                            <field name="leitura_agua_ids">
                                <tree editable="bottom">
                                    <field name='data_referencia' width ='90'/>
                                    <field name='anterior'  width ='120'/>
                                    <field name='atual' width ='120'/>
                                    <field name='consumo' width ='120'/>
                                    <field name='obs' width ='140'/>
                                 
                                </tree>
                            </field>

                        </page>

                        <page string="Log de visitantes" name="visitantes_page">
                            <field name="visitor_ids"
                                   nolabel="1"
                                   readonly="1"
                                   create="false"
                                   delete="false">

                                <tree string="Histórico de Visitantes"
                                      decoration-success="status == 'presente'"
                                      decoration-muted="status == 'saiu'">

                                    <field name="visitante_id"/>
                                    <field name="data_entrada"/>
                                    <field name="data_saida"/>
                                    <field name="tempo_permanencia"
                                           widget="float_time"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Tags" name="tags_page">
                            <field name="tag_ids">
                                <tree string="Tags da Moradia"
                                      editable="bottom">
                                    <field name="name"/>
                                    <field name="numero_tag"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Pets" name="pets_page">
                            <field name="pet_ids">
                                <tree string="Pets da Moradia"
                                      editable="bottom">
                                    <field name="name"/>
                                    <field name="raça"/>
                                    <field name="nome"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Veículos" name="veiculos_page">
                            <field name="vehicle_ids">
                                <tree string="Veículos da Moradia"
                                    editable="bottom">

                                    <field name="name" string="Modelo" width="120"/>
                                    <field name="marca" width="110"/>
                                    <field name="cor" width="110"/>
                                    <field name="placa" width="110"/>
                                    <field name="possui_tag" width="100"/>
                                    <field name="numero_tag"
                                         width="100"
                                        attrs="{'invisible': [('possui_tag', '=', False)]}"/>
                                    <field name="quantidade" width="100"/>

                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
                <div class="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="activity_ids"/>
                <field name="message_ids"/>
            </div>
            </form>
        </field>
    </record>

    <record id="view_condo_residence_search" model="ir.ui.view">
    <field name="name">condo.residence.search</field>
    <field name="model">condo.residence</field>
    <field name="arch" type="xml">
        <search string="Pesquisar Residências">

            <field name="name"/>
            <field name="lote"/>
            <field name="rua"/>
            <field name="tipo"/>
            <field name="inquilino_id"/>
            <field name="proprietario_id"/>

            <filter string="Ativas"
                    name="active"
                    domain="[('active', '=', True)]"/>

            <filter string="Inativas"
                    name="inactive"
                    domain="[('active', '=', False)]"/>

            <separator/>

            <filter string="Com Moradores"
                    name="with_residents"
                    domain="[('partner_ids', '!=', False)]"/>

            <filter string="Sem Moradores"
                    name="without_residents"
                    domain="[('partner_ids', '=', False)]"/>

            <separator/>

            <filter string="Com Pets"
                    name="with_pets"
                    domain="[('pet_ids', '!=', False)]"/>

            <filter string="Sem Pets"
                    name="without_pets"
                    domain="[('pet_ids', '=', False)]"/>

            <filter string="Com Veículos"
                    name="with_vehicles"
                    domain="[('vehicle_ids', '!=', False)]"/>

            <filter string="Sem Veículos"
                    name="without_vehicles"
                    domain="[('vehicle_ids', '=', False)]"/>

            <filter string="Com Tags"
                    name="with_tags"
                    domain="[('tag_ids', '!=', False)]"/>

            <filter string="Sem Tags"
                    name="without_tags"
                    domain="[('tag_ids', '=', False)]"/>

            <separator/>

            <filter string="Com Inquilino"
                    name="with_tenant"
                    domain="[('inquilino_id', '!=', False)]"/>

            <filter string="Com Proprietário"
                    name="with_owner"
                    domain="[('proprietario_id', '!=', False)]"/>

            <group expand="0" string="Agrupar por">
                <filter string="Lote"
                        name="group_by_lote"
                        context="{'group_by': 'lote'}"/>

                <filter string="Rua"
                        name="group_by_rua"
                        context="{'group_by': 'rua'}"/>

                <filter string="Tipo"
                        name="group_by_tipo"
                        context="{'group_by': 'tipo'}"/>

                <filter string="Inquilino"
                        name="group_by_tenant"
                        context="{'group_by': 'inquilino_id'}"/>

                <filter string="Proprietário"
                        name="group_by_owner"
                        context="{'group_by': 'proprietario_id'}"/>

                <filter string="Status"
                        name="group_by_active"
                        context="{'group_by': 'active'}"/>
            </group>
        </search>
    </field>
</record>

<record id="view_condo_residence_tree" model="ir.ui.view">
    <field name="name">condo.residence.tree</field>
    <field name="model">condo.residence</field>
    <field name="arch" type="xml">
        <tree string="Residências">

            <!-- <field name="image_128" widget="image" class="oe_avatar"/> -->

            <field name="name"/>

            <field name="rua"/>
            <field name="numero"/>
            <field name="lote"/>

            <field name="tipo"
                   widget="badge"
                   decoration-primary="tipo == 'casa'"
                   decoration-info="tipo == 'apartamento'"/>

            <field name="moradores" sum="Total de Moradores"/>

            <field name="inquilino_id"
                   optional="show"/>

            <field name="proprietario_id"
                   optional="show"/>

            <field name="active"
                   widget="boolean_toggle"
                    optional="hide"/>

        </tree>
    </field>
</record>

<record id="action_condo_residence" model="ir.actions.act_window">
    <field name="name">Residências</field>
    <field name="res_model">condo.residence</field>
    <field name="view_mode">kanban,form,tree</field>
    <field name="search_view_id" ref="view_condo_residence_search"/>
</record>

<menuitem id="menu_condo_residence_root"
          name="Residências"
          parent="contacts.menu_contacts"
          sequence="10"/>

<menuitem id="menu_condo_residence"
          name="Gerenciar Residências"
          parent="menu_condo_residence_root"
          action="action_condo_residence"/>
          
<menuitem id="menu_water_report_wizard_agua"
          name="Exportar Relatório Água"
          parent="menu_condo_residence_root"
          action="action_water_report_wizard"
          groups="base.group_user"
          sequence="20"/>
</odoo>