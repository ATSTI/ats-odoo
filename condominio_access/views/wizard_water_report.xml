<odoo>

    <record id="view_condo_water_report_wizard" model="ir.ui.view">
        <field name="name">condo.water.report.wizard.form</field>
        <field name="model">condo.water.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Relatório Água">
                <group>
                    <field name="mes"/>
                    <field name="ano"/>
                    <field name="metro"/>
                </group>
                <footer>
                    <button name="action_export_pdf"
                            type="object"
                            string="Exportar PDF"
                            class="btn-primary"/>

                    <button string="Cancelar"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

<record id="action_water_report_wizard" model="ir.actions.act_window">
    <field name="name">Relatório Água</field>
    <field name="res_model">condo.water.report.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

<record id="action_report_water_reading"
            model="ir.actions.report">
        <field name="name">Relatório Leituras Água</field>
        <field name="model">condo.water.reading</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">condominio_access.report_water_reading_template</field>
        <field name="report_file">condominio_access.report_water_reading_template</field>
    </record>

</odoo>