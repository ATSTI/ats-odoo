<odoo>
<record id="view_import_water_wizard_form" model="ir.ui.view">
    <field name="name">condo.import.water.wizard.form</field>
    <field name="model">condo.import.water.wizard</field>
    <field name="arch" type="xml">
        <form string="Importar Leituras">
            <group>
                <field name="file" filename="filename"/>
                <field name="filename" invisible="1"/>
            </group>

            <footer>
                <button name="action_import"
                        type="object"
                        string="Importar"
                        class="btn-primary"/>
                <button string="Cancelar"
                        special="cancel"/>
            </footer>
        </form>
    </field>
</record>
</odoo>