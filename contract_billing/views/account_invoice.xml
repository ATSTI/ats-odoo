<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_einvoice_invoice_form_inherit" model="ir.ui.view">
        <field name="name">account.einvoice.invoice.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_br_account.invoice_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="email_send" />
            </field>
        </field>
    </record>

    <record id="br_account_tag_ids_form" model="ir.ui.view">
        <field name="name">br_account.tag_ids.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <label for="journal_id" position="before">
		        <field
                    name="move_tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
            </label>
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <label for="partner_website" invisible="move_type not in ['out_invoice','out_refund']"/>
                <div invisible="move_type not in ['out_invoice','out_refund']">
                    <field name="partner_website" widget="url" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
