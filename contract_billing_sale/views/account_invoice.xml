<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_einvoice_invoice_form_inherit" model="ir.ui.view">
        <field name="name">account.einvoice.invoice.form.inherit</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="br_account.view_br_account_invoice_form"/>
        <field name="arch" type="xml">
            <field name="date_invoice" position="after">
                <field name="email_send" />
                <field name="local" />
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_ctr" model="ir.ui.view">
        <field name="name">view_account_invoice_filter_ctr</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="local"/>
            </field>
            <filter name="status"  position="after">
                <filter name="local" string="Local" context="{'group_by':'local'}"/>
            </filter>
        </field>
    </record>
</odoo>
