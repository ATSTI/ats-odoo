<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="br_sale_tag_ids_form" model="ir.ui.view">
        <field name="name">br_sale.tag.ids.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="before">
                <field
                    name="sale_tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
            </field>
        </field>
    </record>

    <record id="saleorder_tree_view_tag" model="ir.ui.view">
        <field name="name">saleorder.tree.view.tag</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="sale_tag_ids" optional="show"/>
            </xpath>
        </field>
    </record>


</odoo>
