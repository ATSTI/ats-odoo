<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        License AGPL-3.0 or later (https://www.gnu.org/licenses/agpl).
    -->

     <record model="ir.actions.act_window" id="controle_visita_action">
        <field name="name">Controle Visitas</field>
        <field name="res_model">controle.visita</field>
        <field name="view_type">form</field>
    </record>

    <record id="view_controle_visita_form" model="ir.ui.view">
        <field name="name">controle.visita.form</field>
        <field name="model">controle.visita</field>
        <field name="arch" type="xml">
            <form string="Controle Visita">
               <sheet>
                   <group>
                        <field name="data_visita" readonly="1"/>
                        <field name="carteirinha"/>
                    </group>
                    <group>
                        <field name="socio_id" options="{'no_create ': True, 'no_create_edit' : True}"/>
                        <field name="name"/>
                        <field name="user_id" readonly="1"/>
                        <field name="cobrado" readonly="1"/>
                   </group>
               </sheet>
            </form>
        </field>
    </record>
    <record id="view_controle_visita_tree" model="ir.ui.view">
        <field name="name">controle.visita.list</field>
            <field name="model">controle.visita</field>
            <field name="arch" type="xml">
                <tree string="Controle de Visitas" toolbar="1" >
                    <field name="data_visita" readonly="1"/>
                    <field name="carteirinha"/>
                    <field name="socio_id"/>
                    <field name="name"/>
                    <field name="user_id" readonly="1"/>
                    <field name="cobrado" readonly="1"/>
                </tree>
            </field>
        </record>

        <menuitem id="menu_controle_visita"
            name="Controle Visita"
            action="controle_visita_action"
            parent="sale.sale_order_menu"
            sequence="2" groups="sales_team.group_sale_salesman"/>
</odoo>
