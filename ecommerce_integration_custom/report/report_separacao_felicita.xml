<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_separacao">
        <t t-call="web.html_container">
            <div class="page">
                <div class="oe_structure"/>
                <h2 style="text-align: center; font-size: 20px; margin-top: 0px; margin-bottom: 0px;">Lista de Separação</h2>
                <br/><br/>
                <t t-set="product" t-value="set()" />
                <t t-foreach="request.env['sale.order.line'].search([('order_id', 'in', (docs.mapped('id')))])" t-as="prod">
                    <t t-set="product" t-esc="product.add(prod.product_id)"/>
                </t>
                <table style="border: 1px solid #dcdcdc; border-collapse: collapse; font-size:14px;width: 100%;">
                    <tr>
                        <td style="border: 1px solid #dcdcdc; height:27px;  border-collapse: collapse; font-size:12px;text-align: left; width: 50%">
                            <b>Produto</b>
                        </td>
                        <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 20%">
                            <b>Demanda</b>
                        </td>
                        <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 30%">
                            <b>Cod Barras</b>
                        </td>
                    </tr>
                    <t t-foreach="product" t-as="p" >
                        <t t-set="qtd" t-value="0" />
                        <t t-foreach="request.env['sale.order.line'].search([('order_id', 'in', (docs.mapped('id'))), ('product_id', '=', p.id)])" t-as="pr_line">
                            <t t-set="qtd" t-value="qtd + pr_line.product_uom_qty" />
                        </t>
                        <tr>
                        <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: left; width: 50%;">
                            <t t-esc="p.name" ></t>
                        </td>
                        <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: center; width: 20%;">
                            <span t-esc="qtd"/>
                        </td>
                        <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: center; width: 30%;">
                            <span t-esc="p.barcode"/>
                        </td>
                    </tr>
                    </t>
                </table>
                <br/><br/>
                <t t-set="total_produtos" t-value="0"/>
                <t t-foreach="docs" t-as="o">
                    <table style="border: 1px solid #dcdcdc; border-collapse: collapse; font-size:14px;width: 100%;">
                        <tr>
                            <td style="border: 1px solid #dcdcdc; height:27px;  border-collapse: collapse; font-size:12px;text-align: center; width: 20%">
                                <t t-foreach="o.tag_ids" t-as="tag">
                                    <span>Plataforma: <b><t t-esc="tag.name"/></b></span>
                                </t>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 40%">
                                <span>Pedido: <b style="font-size:15px;" t-field="o.name"/></span>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:27px; font-size:12px;text-align: center;border-collapse: collapse; width: 20%">
                                <span>Nome: <b style="font-size:12px;" t-field="o.partner_id.name"/></span>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; width: 5%"></td>
                            <td style="border: 1px solid #dcdcdc; height:27px; font-size:12px;text-align: center;border-collapse: collapse; width: 15%">
                                <span>Enviar Até: </span><p/><b style="font-size:10px;" t-field="o.commitment_date"/>
                            </td>
                        </tr>
                    </table>
                    <table style="border: 1px solid #dcdcdc; border-collapse: collapse; font-size:14px;width: 100%;">
                        <tr>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 5%">
                                <b>Item</b>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 45%">
                                <b>Produto</b>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 5%">
                                <b>Qtd</b>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 25%">
                                <b>Componentes (KIT)</b>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 30%">
                                <b>Cod Barras</b>
                            </td>
                        </tr>
                        <t t-set="linhas" t-value="2" />
                        <t t-set="item" t-value="0" />
                            <t t-foreach="o.order_line" t-as="line">
                                <t t-set="item" t-value="item + 1" />
                                <t t-set="linhas" t-value="linhas - 1" />
                                <t t-set="total_produtos" t-value="total_produtos + line.product_uom_qty"/>
                                <tr>
                                    <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: center; width: 5%;">
                                        <t t-esc="item" ></t>
                                    </td>
                                    <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: left; width: 50%;">
                                        [<span t-field="line.product_id.default_code"/>]<span t-field="line.name"/>
                                    </td>
                                    <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: center; width: 5%;">
                                        <span t-field="line.product_uom_qty"/>
                                    </td>
                                    <t t-if="line.product_id.product_tmpl_id.bom_ids" >
                                        <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:10px;text-align: left; width: 20%;">
                                            <t t-foreach="line.product_id.product_tmpl_id.bom_ids" t-as="mrp">
                                                <t t-foreach="mrp.bom_line_ids" t-as="bom">
                                                    <span t-field="bom.product_id.name"/><br/>
                                                </t>
                                            </t>
                                        </td>
                                        <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: center; width: 20%;">
                                            <t t-foreach="line.product_id.product_tmpl_id.bom_ids" t-as="mrp">
                                                <t t-foreach="mrp.bom_line_ids" t-as="bom">
                                                    <span t-field="bom.product_id.barcode"/><br/>
                                                </t>
                                            </t>
                                        </td>
                                    </t>
                                    <t t-else="">
                                        <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: center; width: 20%;">
                                        </td>
                                        <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: center; width: 20%;">
                                            <span t-field="line.product_id.barcode"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        <t t-foreach="range(linhas)" t-as="compl">
                            <tr style="height:17px; border: 1px solid #dcdcdc; height:20px; border-collapse: collapse">
                                <td ></td> 
                                <td ></td>
                                <td ></td>
                                <td ></td>
                            </tr>
                        </t>
                    </table>
                </t>

            </div>
        </t>
    </template>
</odoo>