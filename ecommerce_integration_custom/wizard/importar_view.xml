<?xml version="1.0"?>
<odoo>
    <record id="importar_pedido_online" model="ir.ui.view">
        <field name="name">importar.peddo.online</field>
        <field name="model">importar.pedido.online</field>
        <field name="arch" type="xml">
            <form string="Importar Pedido Online">
                <group>
                    <group>
                        <field name="shopee" attrs="{'invisible': [('meli', '=', True)]}"/>
                        <field name="meli" attrs="{'invisible': [('shopee', '=', True)]}"/>
                        <!-- <field name="shopee_config_id"  attrs="{'invisible': [('shopee', '=', False)]}"/>
                        <field name="meli_config_id" attrs="{'invisible': [('meli', '=', False)]}" /> -->
                    </group>
                    <group>
                        <field name="pedido_id"/>
                    </group>
                </group>
                <footer>
                    <button
                        name="action_importar_pedido"
                        string="Importar Pedido"
                        class="btn-primary"
                        type="object"
                    />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_importar_pedido_online_view" model="ir.actions.act_window">
        <field name="name">Importar Pedido Online</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">importar.pedido.online</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="importar_pedido_online"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_importar_wizard"
        name="Importar Pedido Online"
        action="ecommerce_integration_custom.action_importar_pedido_online_view"
        parent="sale.sale_order_menu"
        sequence="99"/>

</odoo>