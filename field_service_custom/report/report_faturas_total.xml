<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_account_fullist">
        <t t-call="web.html_container">
            <div class="page">
                <div class="oe_structure"/>
                <div class="page">
                    <div class="oe_structure"/>
                    <br/>
                    <table style="width:49%; height: 60px;float: left;">
                        <tr><td style="height: 30px"></td></tr>
                        <tr>
                            <td style="text-align: left; width:100%" >
                                <b style="font-size:18px" t-field="docs.company_id.name"/>                                
                                <br/> <span t-field="docs.company_id.street"/>, <span t-field="docs.company_id.street_number"/>
                                <br/> <span t-field="docs.company_id.district"/> - <span t-field="docs.company_id.city_id.name"/>;
                            </td>
                        </tr>
                    </table>
                    <table style="width:49%; height: 30px;text-align: right;">
                        <tr>
                            <td style="width:40%">
                                <div style="width: 100%;float: right;">
                                    <img t-attf-src="data:image/*;base64,{{docs.company_id.logo}}"
                                        t-att-alt="docs.company_id.name" style="width:50%; height:50%"/>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
                <br/><br/>
                <t t-set="product" t-value="set()" />
                <t t-foreach="request.env['account.move.line'].search([('move_id', 'in', (docs.mapped('id')))])" t-as="prod">
                    <t t-set="product" t-esc="product.add(prod.product_id)"/>
                </t>
                <table style="border: 1px solid #dcdcdc; border-collapse: collapse; font-size:14px;width: 100%;">
                    <tr>
                        <td style="border: 1px solid #dcdcdc; height:27px;  border-collapse: collapse; font-size:12px;text-align: left; width: 50%">
                            <b>Produto</b>
                        </td>
                        <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 20%">
                            <b>Demanda</b>
                        </td>
                        <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 20%">
                            <b>Valor Total</b>
                        </td>
                    </tr>
                    <t t-foreach="product" t-as="p" >
                        <t t-set="qtd" t-value="0" />
                        <t t-set="value" t-value="0" />
                        <t t-foreach="request.env['account.move.line'].search([('move_id', 'in', (docs.mapped('id'))), ('product_id', '=', p.id)])" t-as="pr_line">
                            <t t-set="qtd" t-value="qtd + pr_line.quantity" />
                            <t t-set="value" t-value="qtd * pr_line.price_unit" />
                        </t>
                        <tr>
                        <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: left; width: 50%;">
                            <t t-esc="p.name" ></t>
                        </td>
                        <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: center; width: 20%;">
                            <span t-esc="qtd"/>
                        </td>
                        <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: center; width: 20%;">
                            <span t-esc="value" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: docs.currency_id}"/>
                        </td>
                    </tr>
                    </t>
                </table>
                <br/><br/>
                <t t-set="total_produtos" t-value="0"/>
                <t t-foreach="docs" t-as="o">
                    <table style="border: 1px solid #dcdcdc; border-collapse: collapse; font-size:14px;width: 100%;">
                        <tr>
                            <td style="border: 1px solid #dcdcdc; height:27px;  border-collapse: collapse; font-size:12px;text-align: center; width: 20%">
                                <span>Data da Fatura: <b><t t-esc="o.invoice_date"/></b></span>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 60%">
                                <span>Pedido: <b style="font-size:15px;" t-field="o.name"/></span>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; width: 10%"></td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; width: 5%"></td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; width: 5%"></td>
                        </tr>
                    </table>
                    <table style="border: 1px solid #dcdcdc; border-collapse: collapse; font-size:14px;width: 100%;">
                        <tr>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 5%">
                                <b>Item</b>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 45%">
                                <b>Produto</b>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 5%">
                                <b>Qtd</b>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 5%">
                                <b>Preço Unit</b>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:27px; border-collapse: collapse; font-size:12px;text-align: center; width: 5%">
                                <b>Preço Total</b>
                            </td>
                        </tr>
                        <t t-set="linhas" t-value="2" />
                        <t t-set="item" t-value="0" />
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <t t-set="item" t-value="item + 1" />
                                <t t-set="linhas" t-value="linhas - 1" />
                                <t t-set="total_produtos" t-value="total_produtos + line.quantity"/>
                                <tr>
                                    <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: center; width: 5%;">
                                        <t t-esc="item" ></t>
                                    </td>
                                    <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: left; width: 50%;">
                                        <span t-field="line.product_id.name"/>
                                    </td>
                                    <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: center; width: 5%;">
                                        <span t-esc="round(line.quantity, 0)"/>
                                    </td>
                                    <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: center; width: 30%;">
                                        <span t-field="line.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                    </td>
                                    <td style="border: 1px solid #dcdcdc; height:25px; border-collapse: collapse; font-size:12px;text-align: center; width: 30%;">
                                        <span t-field="line.price_subtotal"/>
                                    </td>
                                </tr>
                            </t>
                        <t t-foreach="range(linhas)" t-as="compl">
                            <tr style="height:17px; border: 1px solid #dcdcdc; height:20px; border-collapse: collapse">
                                <td ></td> 
                                <td ></td>
                                <td ></td>
                                <td ></td>
                            </tr>
                        </t>
                    </table>
                </t>

            </div>
        </t>
    </template>
</odoo>