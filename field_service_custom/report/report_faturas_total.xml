<?xml version="1.0"?>
<odoo>
    <template id="report_account_fullist">
        <t t-call="web.html_container">
            <div class="page" style="font-family: 'Arial', sans-serif; color: #333; font-size: 13px;">
                
                <!-- Cabeçalho da empresa (sempre a primeira empresa) -->
                <div style="width:100%; border-bottom: 2px solid #004080; padding-bottom:10px; margin-bottom:20px;">
                    <div style="float:left; width:60%;">
                        <b style="font-size:20px; color:#004080;" t-esc="docs[0].company_id.name"/>
                        <br/>
                        <span t-esc="docs[0].company_id.street"/> - 
                        <span t-esc="docs[0].company_id.district"/><br/>
                        <span t-esc="docs[0].company_id.city_id.name"/>
                    </div>
                    <div style="float:right; width:35%; text-align:right;">
                        <img t-if="docs[0].company_id.logo"
                            t-attf-src="data:image/*;base64,{{docs[0].company_id.logo}}"
                            t-att-alt="docs[0].company_id.name"
                            style="max-width:150px; max-height:80px;"/>
                    </div>
                    <div style="clear:both;"></div>
                </div>

                <!-- Iteração por Fatura -->
                <t t-set="total_produtos" t-value="0"/>
                <t t-foreach="docs" t-as="o">
                    <div style="margin-bottom:30px;page-break-inside: avoid;">

                        <!-- Informações da Fatura -->
                        <table style="width:100%; border:1px solid #ccc; border-collapse:collapse; margin-bottom:10px;">
                            <tr style="background-color:#f3f6fb;">
                                <td style="border:1px solid #ccc; text-align:center; width:20%; padding:6px;">
                                    <b>Data/Hora do Serviço:</b><br/>
                                    
                                    <t t-if="o.fsm_order_ids">
                                        <span t-field="o.fsm_order_ids[0].scheduled_date_start"
                                              t-options="{'widget': 'datetime', 'format': 'HH:mm dd/MM/yyyy'}"/>
                                        </t>
                                        
                                        <t t-else="">
                                            <span t-field="o.invoice_date"
                                                  t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                            </t>
                                        </td>
                                <td style="border:1px solid #ccc; text-align:center; width:40%; padding:6px;">
                                    <b>Cliente</b><br/>
                                    <span style="font-size:14px;" t-field="o.partner_id.name"/>
                                </td>
                                <td style="border:1px solid #ccc; text-align:center; width:40%; padding:6px;">
                                    <b>Pedido</b><br/>
                                    <span style="font-size:14px;" t-field="o.name"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Tabela de Itens -->
                        <table style="width:100%; border:1px solid #ccc; border-collapse:collapse; font-size:13px;">
                            <thead style="background-color:#e8eef7;">
                                <tr>
                                    <th style="border:1px solid #ccc; padding:6px; width:5%;">Item</th>
                                    <th style="border:1px solid #ccc; padding:6px; width:45%; text-align:left;">Produto</th>
                                    <th style="border:1px solid #ccc; padding:6px; width:10%;">Qtd</th>
                                    <th style="border:1px solid #ccc; padding:6px; width:20%;">Preço Unitário</th>
                                    <th style="border:1px solid #ccc; padding:6px; width:20%;">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="item" t-value="0"/>
                                <t t-foreach="o.invoice_line_ids" t-as="line">
                                    <t t-set="item" t-value="item + 1"/>
                                    <t t-set="total_produtos" t-value="total_produtos + line.quantity"/>
                                    <tr t-attf-style="background-color:#{'f9f9f9' if item % 2 == 0 else 'ffffff'};">
                                        <td style="border:1px solid #ddd; text-align:center; padding:5px;">
                                            <t t-esc="item"/>
                                        </td>
                                        <td style="border:1px solid #ddd; text-align:left; padding:5px;">
                                            <span t-field="line.product_id.name"/> - <span t-field="line.date_line" />
                                        </td>
                                        <td style="border:1px solid #ddd; text-align:center; padding:5px;">
                                            <span t-esc="round(line.quantity, 0)"/>
                                        </td>
                                        <td style="border:1px solid #ddd; text-align:right; padding:5px;">
                                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": docs[0].currency_id}'/>
                                        </td>
                                        <td style="border:1px solid #ddd; text-align:right; padding:5px;">
                                            <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": docs[0].currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

                <!-- Resumo Final -->
                <div style="margin-top:40px;page-break-inside: avoid;">
                    <h3 style="background-color:#004080; color:white; padding:8px; font-size:16px;">Resumo Geral de Produtos</h3>

                    <t t-set="product" t-value="set()" />
                    <t t-foreach="request.env['account.move.line'].search([('move_id', 'in', (docs.mapped('id')))])" t-as="prod">
                        <t t-if="prod.product_id">
                            <t t-set="dummy" t-value="product.add(prod.product_id)" />
                        </t>
                    </t>

                    <t t-set="valores" t-value="[]" />

                    <table style="width:100%; border:1px solid #ccc; border-collapse:collapse;">
                        <thead style="background-color:#e8eef7;">
                            <tr>
                                <th style="border:1px solid #ccc; padding:6px; text-align:left;">Produto</th>
                                <th style="border:1px solid #ccc; padding:6px; text-align:center;">Quantidade Total</th>
                                <th style="border:1px solid #ccc; padding:6px; text-align:right;">Valor Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="product" t-as="p">
                                <t t-set="qtd" t-value="0"/>
                                <t t-set="value" t-value="0"/>
                                <t t-foreach="request.env['account.move.line'].search([('move_id', 'in', docs.mapped('id')), ('product_id', '=', p.id)])" t-as="pr_line">
                                    <t t-set="qtd" t-value="qtd + pr_line.quantity"/>
                                    <t t-set="value" t-value="value + pr_line.price_subtotal"/>
                                </t>
                                <t t-set="valores" t-value="valores + [value]"/>

                                <tr>
                                    <td style="border:1px solid #ddd; padding:6px;">
                                        <t t-esc="p.name"/>
                                    </td>
                                    <td style="border:1px solid #ddd; padding:6px; text-align:center;">
                                        <span t-esc="qtd"/>
                                    </td>
                                    <td style="border:1px solid #ddd; padding:6px; text-align:right;">
                                        <span t-esc="value" t-options='{"widget": "monetary", "display_currency": docs[0].currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <t t-set="value_t" t-value="sum(valores)" />
                        <t t-set="qtd_total_geral" t-value="0"/>
                        <t t-foreach="product" t-as="p">
                            <t t-set="qtd_soma" t-value="0"/>
                            <t t-foreach="request.env['account.move.line'].search([('move_id', 'in', docs.mapped('id')), ('product_id', '=', p.id)])" t-as="pr_line">
                                <t t-set="qtd_soma" t-value="qtd_soma + pr_line.quantity"/>
                            </t>
                            <t t-set="qtd_total_geral" t-value="qtd_total_geral + qtd_soma"/>
                        </t>
                        <tfoot>
                            <tr style="background-color:#f3f6fb;">
                                <td style="border:1px solid #ccc; padding:8px; text-align:right;"><b>Total Geral de Quantidades:</b></td>
                                <td colspan="2" style="border:1px solid #ccc; padding:8px; text-align:left;">
                                    <b><span t-esc="qtd_total_geral"/></b>
                                </td>
                            </tr>
                            <tr style="background-color:#f3f6fb;">
                                <td colspan="2" style="border:1px solid #ccc; padding:8px; text-align:right;"><b>Total Geral:</b></td>
                                <td style="border:1px solid #ccc; padding:8px; text-align:right;">
                                    <b><span t-esc="value_t" t-options='{"widget": "monetary", "display_currency": docs[0].currency_id}'/></b>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>