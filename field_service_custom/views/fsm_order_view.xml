    <record id="fsm_order_kanban_view_order_by_created" model="ir.ui.view">
        <field name="name">fsm.order.kanban.order.by.create_date</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_kanban_view"/>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="default_order">create_date desc</attribute>
            </kanban>
        </field>
    </record>

    <record id="fsm_order_form_custom_calendar" model="ir.ui.view">
        <field name="name">fsm.order.form.calendar</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_calendar_view"/>
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="replace">
                <calendar
                    string="FSM Orders"
                    date_start="scheduled_date_start"
                    date_delay="scheduled_duration"
                    color="stage_id"
                >
                    <field name="name" invisible="1"/>
                    <field name="stage_id" filters="1" invisible="1"/>
                    <field name="location_id" />
                    <field name="loc_location" />
                    <field name="phone" invisible="1"/>
                    <field
                        name="person_id"
                        write_model="fsm.person.calendar.filter"
                        write_field="fsm_person_id"
                        avatar_field="image_128"
                    />
                    <field name="team_id" filters="1" invisible="1"/>
                    <field name="city" invisible="1"/>
                    <field name="state_name" invisible="1"/>
                </calendar>
            </xpath>
        </field>
    </record>
</odoo>
