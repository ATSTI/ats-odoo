<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_order_form_custom_account" model="ir.ui.view">
        <field name="name">fsm.order.form.isp.account</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice_isp_account.fsm_order_form_isp_account"/>
        <field name="arch" type="xml">
            <xpath expr="//group[field[@name='contractor_cost_ids']]" position="attributes">
                <attribute name="string">Fatura da Facilitadora</attribute>
            </xpath>
            <xpath expr="//group[field[@name='employee_timesheet_ids']]" position="attributes">
                <attribute name="string">Fatura de Cliente</attribute>
            </xpath>
            <xpath expr="//group[field[@name='type']]" position="replace">
                <group invisible="1" name="fsm_order_type">
                    <field
                        name="type"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field
                        name="template_id"
                        groups="fieldservice.group_fsm_template"
                    />
                    <field name="priority" widget="priority" />
                    <field
                        name="tag_ids"
                        widget="many2many_tags"
                        options="{'color_field': 'color', 'no_create_edit': True}"
                    />
                </group>
            </xpath>
        </field>
    </record>

    <record id="fsm_order_kanban_view_order_by_created" model="ir.ui.view">
        <field name="name">fsm.order.kanban.order.by.create_date</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_kanban_view"/>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="default_order">create_date desc</attribute>
            </kanban>
        </field>
    </record>
</odoo>
