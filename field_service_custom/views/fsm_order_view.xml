<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_order_form_custom_account" model="ir.ui.view">
        <field name="name">fsm.order.form.isp.account</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice_isp_account.fsm_order_form_isp_account"/>
        <field name="arch" type="xml">
            <xpath expr="//group[field[@name='contractor_cost_ids']]" position="attributes">
                <attribute name="string">Fatura da Facilitadora</attribute>
            </xpath>
            <xpath expr="//group[field[@name='employee_timesheet_ids']]" position="attributes">
                <attribute name="string">Fatura de Cliente</attribute>
            </xpath>
            <xpath expr="//group[field[@name='type']]" position="replace">
                <group invisible="1" name="fsm_order_type">
                    <field
                        name="type"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field
                        name="template_id"
                        groups="fieldservice.group_fsm_template"
                    />
                    <field name="priority" widget="priority" />
                    <!-- <field
                        name="tag_ids"
                        widget="many2many_tags"
                        options="{'color_field': 'color', 'no_create_edit': True}"
                    /> -->
                </group>
            </xpath>
            <!-- <xpath expr="//field[@name='company_id']" position="after">
                <field name="operating_unit_id" groups="base.group_multi_company"/>
            </xpath> -->
        </field>
    </record>

    <record id="fsm_order_form_custom_ordenate" model="ir.ui.view">
        <field name="name">fsm.order.form.ordenate</field>
        <field name="model">fsm.order</field>
        <field name="priority" eval="17"/>
        <field name="inherit_id" ref="fieldservice.fsm_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='customer_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="before">
                <field name="customer_id"/>
            </xpath>
        </field>
    </record>

    <record id="fsm_order_kanban_view_order_by_created" model="ir.ui.view">
        <field name="name">fsm.order.kanban.order.by.create_date</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_kanban_view"/>
        <field name="arch" type="xml">

            <kanban position="attributes">
                <attribute name="default_order">create_date desc</attribute>
            </kanban>

           <xpath expr="//kanban" position="inside">
                <field name="customer_address"/>
                <field name="scheduled_date_start"/>
                <field name="scheduled_date_end"/>
            </xpath>

           <xpath expr="//t[@t-name='kanban-box']//field[@name='location_id']" position="after">
                <div class="text-muted" style="font-size:12px;">
                    <i class="fa fa-map-marker"/>
                    <field name="customer_address"/>
                    <field name="scheduled_date_start"/> - 
                    <field name="scheduled_date_end"/>
                </div>
            </xpath>

        </field>
    </record>   
    <record id="fsm_order_form_custom_calendar" model="ir.ui.view">
        <field name="name">fsm.order.form.calendar</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_calendar_view"/>
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="replace">
                <calendar
                    string="FSM Orders"
                    date_start="scheduled_date_start"
                    date_delay="scheduled_duration"
                    color="stage_id"
                >
                    <field name="name" invisible="1"/>
                    <field name="stage_id" filters="1" invisible="1"/>
                    <field name="location_id" />
                    <field name="loc_location" />
                    <field name="phone" invisible="1"/>
                    <field
                        name="person_id"
                        write_model="fsm.person.calendar.filter"
                        write_field="fsm_person_id"
                        avatar_field="image_128"
                    />
                    <field name="team_id" filters="1" invisible="1"/>
                    <field name="city" invisible="1"/>
                    <field name="state_name" invisible="1"/>
                </calendar>
            </xpath>
        </field>
    </record>

    <record id="fsm_order_timeline_replace_view" model="ir.ui.view">
        <field name="name">fsm.order.timeline</field>
        <field name="model">fsm.order</field>
        <field name="type">timeline</field>
        <field name="arch" type="xml">
            <xpath expr="//timeline" position="replace">
                <timeline
                    date_start="scheduled_date_start"
                    date_stop="scheduled_date_end"
                    string="Orders"
                    default_group_by="person_id"
                    event_open_popup="true"
                    colors="#ffffff:stage_id=='New';"
                    custom_color="true"
                >
                </timeline>
            </xpath>
        </field>
    </record>

</odoo>
