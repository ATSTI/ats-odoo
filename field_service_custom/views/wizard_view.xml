<odoo>

 <record id="view_account_move_product_print_form" model="ir.ui.view">
    <field name="name">account.move.product.print.form</field>
    <field name="model">account.move.product.print</field>
    <field name="arch" type="xml">
        <form string="Selecionar Produtos para Cupom">
            <field name="move_id" invisible="1"/>
            <field name="move_line_ids" widget="many2many_checkboxes"/>
            <footer>
                <button name="action_print" type="object" string="Imprimir Cupom" class="btn-primary"/>
                <button string="Cancelar" special="cancel" class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>

<record id="action_account_move_product_print" model="ir.actions.act_window">
    <field name="name">Selecionar Produtos</field>
    <field name="res_model">account.move.product.print</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_account_move_product_print_form"/>
    <field name="target">new</field>
</record>

</odoo>