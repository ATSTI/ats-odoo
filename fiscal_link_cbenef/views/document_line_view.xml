<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="link_cbenef_document_line_form" model="ir.ui.view">
      <field name="name">link.cbenef.document.line.form</field>
      <field name="model">l10n_br_fiscal.document.line</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="l10n_br_fiscal.document_fiscal_line_mixin_form" />
      <field name="arch" type="xml">
        <xpath expr="//field[@name='icms_tax_benefit_id']" position="before">
          <field name="cbenef_id" />
        </xpath>
      </field>
  </record>

</odoo>
