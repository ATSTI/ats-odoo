<?xml version="1.0" encoding="utf-8" ?>
<odoo>

 <record id="tax_definition_icms_tree_inherit" model="ir.ui.view">
    <field name="name">l10n.br.fiscal.tax.definition.icms.tree.inherit</field>
    <field name="model">l10n_br_fiscal.tax.definition</field>
    <field name="inherit_id" ref="l10n_br_fiscal.tax_definition_icms_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='tax_id']" position="after">
            <field name="code"/>
            <field name="benefit_type"/>
            <field name="ncms"/>
            <!-- <field name="icms_regulation_id"/> -->
        </xpath>
    </field>
</record>
</odoo>
