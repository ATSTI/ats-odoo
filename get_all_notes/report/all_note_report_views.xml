<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="all_note_report_view_graph" model="ir.ui.view">
            <field name="name">all.note.report.graph</field>
            <field name="model">all.note.report</field>
            <field name="arch" type="xml">
                <graph string="Analysis" type="bar" stacked="True">
                    <field name="x_company_id" type="row" />
                    <field name="x_total_nota" type="measure" />
                    <field name="x_valor_nota" type="measure" />
                </graph>
            </field>
        </record>

        <record id="all_note_report_view_pivot" model="ir.ui.view">
            <field name="name">all.note.report.pivot</field>
            <field name="model">all.note.report</field>
            <field name="arch" type="xml">
                <pivot string="Analysis" stacked="True">
                    <field name="x_company_id" type="row" />
                    <field name="x_total_nota" type="measure" />
                    <field name="x_valor_nota" type="measure" />
                </pivot>
            </field>
        </record>

        <template id="report_all_note_template">
            <t t-call="web.external_layout">
                <t t-set="company" t-value="docs and docs[0].x_company_id or user.company_id"/>
                <main>
                <h2>Relatório Notas Empresas</h2>

                <table class="table table-sm" style="width:100%;">
                    <thead>
                    <tr>
                        <th>Empresa</th>
                        <th>Total Nota</th>
                        <th>Valor Nota</th>
                    </tr>
                    </thead>
                    <tbody>
                    <!-- Assumindo que os docs estão ordenados por empresa -->
                    <t t-set="empresas_processadas" t-value="[]" />
                    <t t-foreach="docs" t-as="doc">
                        <t t-if="not doc.x_company_id.id in empresas_processadas">
                            <t t-set="empresa" t-value="doc.x_company_id" />
                            <t t-set="qtd" t-value="0" />
                            <t t-set="vlr" t-value="0" />
                            <t t-foreach="docs" t-as="d">
                                <t t-if="d.x_company_id.id == empresa.id">
                                <t t-set="qtd" t-value="qtd + d.x_total_nota" />
                                <t t-set="vlr" t-value="vlr + d.x_valor_nota" />
                                </t>
                            </t>
                            <tr>
                                <td><t t-esc="empresa.name" /></td>
                                <td style="text-align: right"><t t-esc="qtd" /></td>
                                <td style="text-align: right">
                                    <t t-esc="vlr" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: empresa.currency_id}"/>
                                </td>
                            </tr>
                            <t t-set="empresas_processadas" t-value="empresas_processadas + [empresa.id]" />
                        </t>
                    </t>
                    </tbody>
                </table>
                </main>
            </t>
        </template>
    
        <report
            id="action_report_all_note"
            model="all.note.report"
            string="Relatório Notas Empresas"
            report_type="qweb-pdf"
            name="get_all_notes.report_all_note_template"
            file="get_all_notes.report_all_note_template"
            print_report_name="'Notas Empresas'"
        />

        <record id="all_note_report_view_tree" model="ir.ui.view">
            <field name="name">all.note.report.tree</field>
            <field name="model">all.note.report</field>
            <field name="arch" type="xml">
                <tree name="Analysis">
                    <header>
                        <button name="%(action_report_all_note)d" string="Imprimir" type="action" class="btn-primary"/>
                    </header>
                    <field name="x_company_id" />
                    <field name="x_numero_nota" />
                    <field name="x_status_nota" />
                    <field name="x_total_nota"  invisible="1"/>
                    <field name="x_valor_nota" />
                    <field name="x_data_nota" />
                </tree>
            </field>
        </record>

