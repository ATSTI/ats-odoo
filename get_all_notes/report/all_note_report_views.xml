       <record id="all_note_report_action" model="ir.actions.act_window">
           <field name="name">Notas Empresas</field>
           <field name="res_model">all.note.report</field>
           <field name="view_mode">pivot,tree,graph</field>
           <field name="context">{
            'pivot_row_groupby': ['x_company_id'],
            'pivot_column_groupby': []
        }</field>

            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No data yet!
                </p><p>
                    Start scheduling activities on your opportunities
                </p>
            </field>
       </record>

       <menuitem
            id="all_note_report_menu"
            name="Notas Empresas"
            groups="l10n_br_fiscal.group_manager"
            parent="l10n_br_fiscal.accountant_menu"
            action="all_note_report_action"
            sequence="999"/>

