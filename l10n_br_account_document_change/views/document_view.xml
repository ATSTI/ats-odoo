<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="fiscal_patch_document_form_inherit" model="ir.ui.view">
      <field name="name">fiscal_patch.document.form.inherit</field>
      <field name="model">l10n_br_fiscal.document</field>
      <field name="priority">999</field>
      <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
      <field name="arch" type="xml">
        <xpath expr="//button[@name='action_document_back2draft']" position="replace">
          <button name="action_document_back2draft" type="object" string="Voltar p/ Em Digitação" groups="l10n_br_fiscal.group_user" class="btn-secondary" invisible="1"/>
          <button
            name="action_back_account"
            type="object"
            string="Voltar p/ Fatura"
            groups="l10n_br_fiscal.group_user"
            class="btn-secondary"
          />
        </xpath>
        <xpath expr="//field[@name='fiscal_operation_id']" position="replace">
          <field name="fiscal_operation_id" attrs="{'readonly': [('state_edoc', '!=', 'em_digitacao')]}" />
        </xpath>
        <xpath expr="//field[@name='edoc_purpose']" position="replace">
          <field name="edoc_purpose" attrs="{'readonly': [('state_edoc', '!=', 'em_digitacao')]}" />
        </xpath>
        <xpath expr="//field[@name='ind_final']" position="replace">
