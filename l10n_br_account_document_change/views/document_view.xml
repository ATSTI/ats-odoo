        <!-- <xpath expr="//field[@name='document_type_id']" position="attributes">
          <attribute name="readonly">Z</attribute>
        </xpath> -->
        <xpath expr="//field[@name='document_key']" position="replace">
          <field name="document_key" attrs="{'readonly': [('state_edoc', '!=', 'em_digitacao')]}" />
        </xpath>
