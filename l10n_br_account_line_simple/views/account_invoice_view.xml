<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="invoice_simple_line_form" model="ir.ui.view">
        <field name="name">l10n_br_account.invoice.simple_line.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_br_account.invoice_form" />
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <field name="fiscal_price" position="replace">
                <field name="fiscal_price" invisible="1"/>
            </field>
            <field name="discount_value" position="replace">
                <field name="discount_value" invisible="1"/>
            </field>
            <field name="fiscal_quantity" position="replace" />
            <field name="uot_id" position="replace" />
            <label for="fiscal_quantity" position="replace">
                <notebook colspan="4">
                    <page string="Geral">
                    </page>
                    <page string="Inf Fiscal">
                        <group>
                            <group>
                                <label
                                    for="fiscal_quantity"
                                    string="Quantidade Fiscal"
                                    attrs="{'invisible': [('document_type_id', '=', False)]}"
                                />
                                <div>
                                    <field
                                        name="fiscal_quantity"
                                        class="oe_inline"
                                        attrs="{'invisible': [('document_type_id', '=', False)]}"
                                        context="{'partner_id':parent.partner_id, 'quantity':fiscal_quantity, 'uom':uot_id, 'uom_qty_change':True, 'company_id': parent.company_id}"
                                    />
                                    <field
                                        name="uot_id"
                                        force_save="1"
                                        groups="uom.group_uom"
                                        class="oe_inline oe_no_button"
                                        attrs="{'required': [('display_type', '=', False),('document_type_id', '!=', False)], 'invisible': [('document_type_id', '=', False)]}"
                                    />
                                </div>
                                <label for="fiscal_price" string="Preço Fiscal" />
                                <div>
                                    <field name="fiscal_price" attrs="{'invisible': [('document_type_id', '=', False)]}"/>
                                </div>
                                <label for="discount_value" string="Valor do desconto" />
                                <div>
                                    <field name="discount_value"/>
                                </div>
                            </group>
                        </group>
                    </page>
                </notebook>
            </label>
            <!-- NAO CONSEGUI COLOCAR ESTES CAMPOS DENTRO DA PAGINA, ELES NÂO SUMIAM
            <field name="fiscal_operation_line_id" position="replace" />
            <field name="fiscal_operation_line_id" position="replace" />
            <field name="cfop_id" position="replace" />
            <field name="ncm_id" position="replace" />
            <field name="fiscal_genre_id" position="replace" />
            <field name="nbm_id" position="replace" />
            <field name="cest_id" position="replace" />
            <field name="city_taxation_code_id" position="replace" />
            <field name="service_type_id" position="replace" />
            <field name="cnae_id" position="replace" />
            <field name="nbs_id" position="replace" /> -->
        </field>
    </record>

    <record id="invoice_simple_line_account_form" model="ir.ui.view">
    <field name="name">l10n_br_account.invoice.account.simple_line.form</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="priority">999</field>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='quantity']" position="replace"/>
        <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='product_uom_id']" position="replace" />
        <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='price_unit']" position="replace" />
        <xpath
            expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='product_id']"
            position="replace"
        >
            <group>
                <label for="product_id" string="Produto" />
                <div>
                    <field name="product_id"/>
                </div>
                <label for="quantity" string="Quantidade" />
                <div>
                    <field name="quantity"/>
                </div>
                <label for="product_uom_id" string="Unidade de Medida" />
                <div>
                    <field name="product_uom_id"/>
                </div>
                <label for="price_unit" string="Preço Unitário" />
                <div>
                    <field name="price_unit"/>
                </div>
            </group>
            <group>
            </group>
        </xpath>
    </field>
</record>

</odoo>
