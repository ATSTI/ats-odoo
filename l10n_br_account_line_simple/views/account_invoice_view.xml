<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="invoice_simple_line_form" model="ir.ui.view">
        <field name="name">l10n_br_account.invoice.simple_line.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='fiscal_operation_id']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='fiscal_operation_line_id']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='cfop_id']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='ncm_id']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='fiscal_genre_id']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='nbm_id']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='cest_id']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='city_taxation_code_id']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='service_type_id']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='cnae_id']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='nbs_id']" position="replace" />

            <!-- Campos não relacionados ao L10n -->
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='analytic_tag_ids']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='national_taxation_code_id']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='operation_indicator_id']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='account_id']" position="replace" />
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='analytic_account_id']" position="replace" />

            <xpath expr="//field[@name='fiscal_price']" position="replace">
                <field name="fiscal_price" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='discount_value']" position="replace">
                <field name="discount_value" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='fiscal_quantity']" position="replace" />
            <xpath expr="//field[@name='uot_id']" position="replace" />
            <label for="fiscal_quantity" position="replace">
                <notebook colspan="4">
                    <page string="Geral">
                        <group style="width: 100%">
                            <label for="fiscal_operation_id" string="Operação" />
                            <div>
                                <field name="fiscal_operation_id" />
                            </div>
                            <label for="fiscal_operation_line_id" string="Linha da Operação" />
                            <div>
                                <field name="fiscal_operation_line_id" />
                            </div>
                            <label for="cfop_id" string="CFOP" />
                            <div>
                                <field name="cfop_id" />
                            </div>
                            <label for="ncm_id" string="NCM" />
                            <div>
                                <field name="ncm_id" />
                            </div>
                            <label for="icms_cst_id" string="CST" />
                            <div>
                                <field name="tax_framework" invisible="1"/>
                                <field name="icms_tax_id" invisible="1"/>
                                <field name="icms_cst_id" 
                                    force_save="1"
                                    attrs="{'readonly': [('icms_tax_id', '!=', False)]}"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                />
                            </div>
                            <label for="cbenef_id" string="Benefício Fiscal" />
                            <div>
                                <field name="cbenef_id" />
                            </div>
                            <label for="tax_classification_id" string="Classificação Tributária" />
                            <div>
                                <field name="tax_classification_id" />
                            </div>
                        </group>
                    </page>
                    <page string="Inf Fiscal">
                        <group>
                            <group style="width: 100%">
                                <label
                                    for="fiscal_quantity"
                                    string="Quantidade Fiscal"
                                    attrs="{'invisible': [('document_type_id', '=', False)]}"
                                />
                                <div>
                                    <field
                                        name="fiscal_quantity"
                                        attrs="{'invisible': [('document_type_id', '=', False)]}"
                                        context="{'partner_id':parent.partner_id, 'quantity':fiscal_quantity, 'uom':uot_id, 'uom_qty_change':True, 'company_id': parent.company_id}"
                                    />
                                    <field
                                        name="uot_id"
                                        force_save="1"
                                        groups="uom.group_uom"
                                        attrs="{'required': [('display_type', '=', False),('document_type_id', '!=', False)], 'invisible': [('document_type_id', '=', False)]}"
                                    />
                                </div>
                                <label for="fiscal_price" string="Preço Fiscal" />
                                <div>
                                    <field name="fiscal_price" attrs="{'invisible': [('document_type_id', '=', False)]}"/>
                                </div>
                                <label for="discount_value" string="Valor do desconto" />
                                <div>
                                    <field name="discount_value"/>
                                </div>

                                <label for="fiscal_genre_id" string="Gênero Fiscal do Produto" />
                                <div>
                                    <field name="fiscal_genre_id" />
                                </div>
                                <label for="nbm_id" string="NBM" />
                                <div>
                                    <field name="nbm_id" />
                                </div>
                                <label for="cest_id" string="CEST" />
                                <div>
                                    <field name="cest_id" />
                                </div>
                                <label for="city_taxation_code_id" string="Código de Tributação" />
                                <div>
                                    <field name="city_taxation_code_id" />
                                </div>
                                <label for="service_type_id" string="Tipo de Serviço" />
                                <div>
                                    <field name="service_type_id" />
                                </div>
                                <label for="cnae_id" string="CNAE" />
                                <div>
                                    <field name="cnae_id" />
                                </div>
                                <label for="nbs_id" string="NBS" />
                                <div>
                                    <field name="nbs_id" />
                                </div>
                            </group>
                        </group>
                    </page>
                </notebook>
            </label>

            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/notebook/page[@name='others']" position="inside" >
                <group string="Contas" colspan="4">
                    <field name="account_id" />
                    <field name="analytic_account_id" />
                </group>
            </xpath>

        </field>
    </record>

    <record id="invoice_simple_line_account_form" model="ir.ui.view">
    <field name="name">l10n_br_account.invoice.account.simple_line.form</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="priority">999</field>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='quantity']" position="replace"/>
        <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='product_uom_id']" position="replace" />
        <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='price_unit']" position="replace" />
        <xpath
            expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='product_id']"
            position="replace"
        >
            <group style="width: 100%">
                <label for="product_id" string="Produto" />
                <div>
                    <field name="product_id"/>
                </div>
                <label for="quantity" string="Quantidade" />
                <div>
                    <field name="quantity"/>
                </div>
                <label for="product_uom_id" string="Unidade de Medida" />
                <div>
                    <field name="product_uom_id"/>
                </div>
                <label for="price_unit" string="Preço Unitário" />
                <div>
                    <field name="price_unit"/>
                </div>
            </group>
        </xpath>
    </field>
</record>

</odoo>
