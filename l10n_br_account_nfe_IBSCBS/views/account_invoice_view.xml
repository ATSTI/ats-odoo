<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_invoice_ibscbs_form" model="ir.ui.view">
        <field name="name">l10n_br_account.invoice.ibscbs.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_br_account.invoice_form" />
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']"
                position="inside"
            >
               <page name="IBS_CBS" string="IBS/CBS">
                    <group name="ibs_cbs" string="IBS/CBS">
                        <field
                            name="ibscbs_tax_id"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                        <field
                            name="ibscbs_cst_id"
                            force_save="1"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                        <field name="ibscbs_cst_code" readonly="1" />
                        <field
                            name="ibsuf_tax_id"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                        <field
                            name="ibsmun_tax_id"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                        <field
                            name="cbs_tax_id"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                        <!-- <field name="ibscbs_value" /> -->
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>