<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_invoice_ibscbs_form" model="ir.ui.view">
        <field name="name">l10n_br_account.invoice.ibscbs.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="after">
                <page name="info_ibscbs" string="Informações do IBSCBS"> 
                    <group name="ibscbs-group" string="IBSCBS">
                        <field name="ibscbs" />
                        <!-- <field name="nfe40_tpGuia" />
                        <field name="nfe40_UFGuia" />
                        <field name="nfe40_serieGuia" />
                        <field name="nfe40_nGuia" /> -->
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>