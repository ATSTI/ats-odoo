<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ibscbs_res_company_form" model="ir.ui.view">
        <field name="name">ibscbs_res.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_nfe.nfe_res_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='danfe_settings']" position="after">
                <group name="ibscbs_settings" string="IBS/CBS Settings" colspan="4">
                    <field name="ibscbs_cst_id" />
                    <field name="ibscbs_cst_code" />
                    <field name="ibsuf_tax_id" />
                    <field name="ibsmun_tax_id" />
                    <field name="cbs_tax_id" />
                </group>
            </xpath>

        </field>
    </record>
</odoo>
