<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_defensivo_tree" model="ir.ui.view">
        <field name="name">res.defensivo.tree</field>
        <field name="model">res.defensivo</field>
        <field name="arch" type="xml">
            <tree>
                <field name="nfe_defensivo_agropecuario_id" />
                <field name="nfe40_nReceituario" />
                <field name="partner_id" />
                <field name="nfe40_CPFRespTec" />
            </tree>
        </field>
    </record>
    <record id="res_defensivo_form" model="ir.ui.view">
        <field name="name">res.defensivo.form</field>
        <field name="model">res.defensivo</field>
        <field name="arch" type="xml">
            <form string="Defensivo Agrícola / Agrotóxico">
                <field name="nfe_defensivo_agropecuario_id" />
                <field name="nfe40_nReceituario" />
                <field name="partner_id" />
                <field name="nfe40_CPFRespTec" />
            </form>
        </field>
    </record>
    <record id="account_invoice_agro_form" model="ir.ui.view">
        <field name="name">l10n_br_account.invoice.card.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="after">
                <page name="info_guia_transp" string="Informações do GuiaTransp"> 
                    <group name="guiatransp-group" string="Guia Transito">
                        <field name="nfe40_tpGuia" />
                        <field name="nfe40_UFGuia" />
                        <field name="nfe40_serieGuia" />
                        <field name="nfe40_nGuia" />
                    </group>
                    <group name="defensivos-group" string="Defensivos">
                        <field name="nfe40_defensivo" context="{'default_invoice_id': active_id}">
                            <tree string="Defensivos" editable="bottom">
                                <field name="nfe_defensivo_agropecuario_id" />
                                <field name="nfe40_nReceituario" />
                                <field name="partner_id" />
                                <field name="nfe40_CPFRespTec" />
                            </tree>
                            <form>
                                <sheet>
                                    <group string="Defensivo Agrícola / Agrotóxico">
                                        <field name="nfe40_nReceituario" />
                                        <field name="partner_id" />
                                        <field name="nfe40_CPFRespTec" />
                                        <field name="nfe_defensivo_agropecuario_id" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </group>                    
                </page>
            </xpath>
        </field>
    </record>

</odoo>