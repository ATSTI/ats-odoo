<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="info_card_tree" model="ir.ui.view">
        <field name="name">info.card.tree</field>
        <field name="model">card.info.payment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="nfe40_CNPJ" />
                <field name="nfe40_tBand" />
                <field name="nfe40_cAut" />
            </tree>
        </field>
    </record>

    <record id="info_card_form" model="ir.ui.view">
        <field name="name">info.card.form</field>
        <field name="model">card.info.payment</field>
        <field name="arch" type="xml">
            <form string="Informações do Cartão">
                <sheet>
                    <group>
                        <field name="nfe40_CNPJ" />
                        <field name="nfe40_tBand" />
                        <field name="nfe40_cAut" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Customer Invoice views -->
    <record id="account_invoice_card_form" model="ir.ui.view">
        <field name="name">l10n_br_account.invoice.card.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_br_account.invoice_form" />
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="after">
                <field name="fiscal_payment_mode" invisible="1" />
                <page name="info_card_pay" string="Informações do pagamento" attrs="{'invisible': [('fiscal_payment_mode', 'not in', ['03','04','17'])]}">
                    <field name="card_ids" context="{'default_move_id': active_id}">
                        <tree string="Info do Pagamento" editable="bottom">
                            <field name="nfe40_CNPJ" />
                            <field name="nfe40_tBand" />
                            <field name="nfe40_cAut" />
                            <field name="am_id" invisible="1"/>
                        </tree>
                        <form>
                            <sheet>
                                <group string="Info do Pagamento">
                                    <group>
                                        <field name="nfe40_CNPJ" />
                                        <field name="nfe40_tBand" />
                                        <field name="nfe40_cAut" />
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>