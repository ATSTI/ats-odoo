<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record forcecreate="True" model="ir.cron" id="automatic_slip_query_bank_inter">
        <field name="name">Automatic Consultation for Bank Payment Slip: Banco Inter</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="model_id" ref="model_account_move_line"/>
        <field name="state">code</field>
        <field name="code">model.all_search_bank_slip()</field>
    </record>
    <record id="ir_cron_import_ofx_id" model="ir.cron">
        <field name="name">Banco Inter - Importar Extrato</field>
        <field name="model_id" ref="model_account_statement_import"/>
        <field name="state">code</field>
        <field name="code">
ontem = datetime.datetime.today() - datetime.timedelta(days=1)
#ontem = datetime.datetime.strptime('2026-05-29', '%Y-%m-%d')
#msg = 'executado importacao extrato :' + str(ontem)
model.import_extract_ofx(ontem, ontem, 7)
#log(msg, level='info')
        </field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
</odoo>