<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_order_form_inherit_danfe_button" model="ir.ui.view">
        <field name="name">sale.order.form.danfe.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_download_danfe"
                        type="object"
                        string="Download DANFE"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'sale')]}" />
            </xpath>
        </field>
    </record>

    <record id="action_download_danfe_mass" model="ir.actions.server">
        <field name="name">Download DANFE</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="binding_type">action</field>
        <field name="code">
            action = env['sale.order'].browse(env.context.get('active_ids')).action_download_danfe()
        </field>
    </record>


</odoo>
