<odoo>
    <template id="report_event_equipamentos_externo">
        <t t-call="web.external_layout">
            <main class="page">
                <h2 style="text-align:center; margin-bottom:15px;">
                    EQUIPAMENTOS UTILIZADOS –
                    <span t-esc="(docs[0].name or '').upper()"/>
                </h2>

                <style>
                    table.equip-table {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 11px;
                        border: 2px solid #000;
                    }
                    table.equip-table th {
                        background-color: #2F4F6F;
                        color: #FFF;
                        text-align: center;
                        padding: 6px;
                        border: 1px solid #000;
                        text-transform: uppercase;
                    }
                    table.equip-table td {
                        padding: 6px;
                        border: 1px solid #000;
                        vertical-align: middle;
                        text-transform: uppercase;
                    }
                    table.equip-table tr:nth-child(even) {
                        background-color: #F2F2F2;
                    }
                    .center {
                        text-align: center;
                    }
                    .tag {
                        font-size: 9px;
                        display: block;
                        margin-top: 2px;
                    }
                    .proprio {
                        font-weight: bold;
                        font-size: 10px;
                    }
                </style>

                <table class="equip-table">
                    <thead>
                        <tr>
                            <th>Participante</th>
                            <th>Gênero</th>
                            <th>Peso</th>
                            <th>Altura</th>
                            <th>Evento</th>
                            <th>BCD</th>
                            <th>Suit</th>
                            <th>Regulador</th>
                            <th>Bag</th>
                        </tr>
                    </thead>

                    <tbody>
                        <t t-foreach="docs[0].registration_ids" t-as="reg">
                            <tr>
                                <td>
                                    <strong t-esc="(reg.partner_id.name or '').upper()"/>
                                </td>

                                <td class="center">
                                    <t t-esc="(reg.genero or '-').upper()"/>
                                </td>

                                <td class="center">
                                    <t t-esc="reg.peso or '-'"/>
                                </td>

                                <td class="center">
                                    <t t-esc="reg.altura or '-'"/>
                                </td>

                                <td class="center">
                                    <t t-esc="(reg.tipo_evento or '-').upper()"/>
                                </td>

                                <!-- BCD -->
                                <td class="center">
                                    <t t-if="reg.bcd_info">
                                        <span class="proprio">EQUIPAMENTO PRÓPRIO</span>
                                    </t>
                                    <t t-elif="reg.bcd_id">
                                        <strong t-esc="reg.bcd_id.display_name.upper()"/>
                                        <span class="tag">
                                            TAG CD:
                                            <t t-esc="(reg.bcd_id.product_tmpl_id.tag_cd or '-').upper()"/>
                                        </span>
                                    </t>
                                    <t t-else="">-</t>
                                </td>

                                <!-- SUIT -->
                                <td class="center">
                                    <t t-if="reg.suit_info">
                                        <span class="proprio">EQUIPAMENTO PRÓPRIO</span>
                                    </t>
                                    <t t-elif="reg.suit_id">
                                        <strong t-esc="reg.suit_id.display_name.upper()"/>
                                        <span class="tag">
                                            TAG CD:
                                            <t t-esc="(reg.suit_id.product_tmpl_id.tag_cd or '-').upper()"/>
                                        </span>
                                    </t>
                                    <t t-else="">-</t>
                                </td>

                                <!-- REG -->
                                <td class="center">
                                    <t t-if="reg.reg_info">
                                        <span class="proprio">EQUIPAMENTO PRÓPRIO</span>
                                    </t>
                                    <t t-elif="reg.reg_id">
                                        <strong t-esc="reg.reg_id.display_name.upper()"/>
                                        <span class="tag">
                                            TAG CD:
                                            <t t-esc="(reg.reg_id.product_tmpl_id.tag_cd or '-').upper()"/>
                                        </span>
                                    </t>
                                    <t t-else="">-</t>
                                </td>

                                <!-- BAG -->
                                <td class="center">
                                    <t t-if="reg.bag_info">
                                        <span class="proprio">EQUIPAMENTO PRÓPRIO</span>
                                    </t>
                                    <t t-elif="reg.bag_id">
                                        <strong t-esc="reg.bag_id.display_name.upper()"/>
                                        <span class="tag">
                                            TAG CD:
                                            <t t-esc="(reg.bag_id.product_tmpl_id.tag_cd or '-').upper()"/>
                                        </span>
                                    </t>
                                    <t t-else="">-</t>
                                </td>

                            </tr>
                        </t>
                    </tbody>
                </table>
            </main>
        </t>
    </template>
</odoo>
