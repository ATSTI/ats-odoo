<odoo>
<record id="view_move_form_inherit_send_button" model="ir.ui.view">
    <field name="name">account.move.form.send.with.attachments</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">

        <xpath expr="//button[@name='action_invoice_sent']" position="after">
            <button name="action_invoice_sent_with_attachments"
                    type="object"
                    string="Enviar Email com Anexos"
                    class="btn-primary"/>
        </xpath>

    </field>
</record>
</odoo>