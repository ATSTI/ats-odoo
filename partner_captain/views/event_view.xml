<odoo>
    <record id="view_event_form_add_tipo_evento" model="ir.ui.view">
        <field name="name">event.event.form.add.tipo.evento</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">

            <!-- BOTÕES NO HEADER -->
            <xpath expr="//header" position="inside">
                <button
                    name="action_call_equipamentos"
                    type="object"
                    string="Atribuir Equipamentos"
                    class="oe_highlight"
                    confirm="Isso irá atribuir os equipamentos aos participantes e marcá-los como USADOS no estoque. Deseja continuar?"
                />

                <button
                    name="action_export_equipamentos_excel"
                    type="object"
                    string="Exportar Equipamentos (Excel)"
                    class="btn-primary"
                />

                <button
                    name="action_limpar_equipamentos"
                    type="object"
                    string="Limpar Equipamentos"
                    class="btn-secondary"
                    confirm="Isso irá remover TODOS os equipamentos atribuídos aos participantes e liberar os produtos. Deseja continuar?"
                />
            </xpath>
            <xpath expr="//field[@name='user_id']" position="replace">
                <field name="staff_ids"
                       widget="many2many_tags"
                       placeholder="Selecione os responsáveis"/>
            </xpath>
        </field>
    </record>
</odoo>
