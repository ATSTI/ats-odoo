<odoo>
    <record id="view_event_form_add_tipo_evento" model="ir.ui.view">
        <field name="name">event.event.form.add.tipo.evento</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_call_equipamentos"
                    type="object"
                    string="Atribuir Equipamentos"
                    class="oe_highlight"
                    attrs="{'invisible': [('tipo_evento', '!=', 'owd')]}"
                />

                <button
                    name="action_limpar_equipamentos"
                    type="object"
                    string="Limpar Equipamentos"
                    class="btn-secondary"
                    confirm="Isso irá remover TODOS os equipamentos atribuídos aos participantes e liberar os produtos. Deseja continuar?"
                />
            </xpath>
            <xpath expr="//field[@name='event_type_id']" position="after">
                <field name="tipo_evento"/>
            </xpath>

        </field>
    </record>
</odoo>
