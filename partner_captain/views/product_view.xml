<?xml version="1.0"?>
<odoo>
    <data>
        <record id="captain_product_template_form_view" model="ir.ui.view">
            <field name="name">captain_product_template_form_view</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="account.product_template_form_view"/>
            <field name="arch" type="xml">
                <field name="type" position="after">
                    <field name="historico_id" />
                </field>
            </field>
        </record>


        <record id="captain_product_template_form_view" model="ir.ui.view">
        <field name="name">captain.product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='barcode']" position="after">
                <field name="situacao"/>
                <field name="modelo"/>
                <field name="tamanho_cd"/>
                <field name="tag_cd"/>
                <field name="is_suit" invisible="1"/>
                <field name="is_reg" invisible="1"/>
                <field name="tipo_suit"
                    attrs="{'invisible': [('is_suit', '=', False)]}"/>
                <field name="tipo_reg"
                    attrs="{'invisible': [('is_reg', '=', False)]}"/>
                <field name="tamanho_etiqueta"/>
                <field name="usado"/>
            </xpath>

            
        </field>
    </record>
    </data>
</odoo>
