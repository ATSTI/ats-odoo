<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_partner_fiscal_comment_form" model="ir.ui.view">
        <field name="name">res.partner.fiscal.comment.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state_tax_number_ids']" position="after">
                <field name="comment_ids" widget="many2many_tags" string="Comentarios"/>
            </xpath>
        </field>
    </record>

</odoo>