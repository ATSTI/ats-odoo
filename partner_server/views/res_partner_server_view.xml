<?xml version="1.0"?>
<odoo>
    <record id="view_server_form" model="ir.ui.view">
        <field name="name">servidores.cadastro.form</field>
        <field name="model">servidores.infos</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string ='Cadastro de servidores'>
                        <field name ='server_name'/>
                        <field name ='obs_server'/> 
                        <field name="porta_ids">
                            <tree string="Info porta" editable="bottom">
                                <field name="nporta"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_campos_tree" model="ir.ui.view">
        <field name="name">servidores.cadastro.form</field>
        <field name="model">servidores.infos</field>
        <field name="arch" type="xml">
            <tree>
                <field name="server_name"/>
                <field name="obs_server"/>
                <field name="porta_ids"/>
            </tree>
        </field>
    </record>

    <record id ='action_servidores_info' model='ir.actions.act_window'>
        <field name='name'>Cadastro de Servidores</field>
        <field name='res_model'>servidores.infos</field>
        <field name='view_mode'>tree,form</field>
    </record>

        <menuitem id="menu_servidores_root" name="Cadastro de Servidores" parent="contacts.menu_contacts" action="action_servidores_info"/>

</odoo>
