<?xml version="1.0"?>
<odoo>
    <record id="view_res_campos_form" model="ir.ui.view">
        <field name="name">res.campos.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page name="tecnical_notes" string="Anotações Técnicas">
                    <group string="Servidor">
                        <field name="servidor_id"/>
                        <field name="obs_server_texto" readonly="1"/>
                    </group>
                    <group string="Porta">
                        <field name="porta_selection"/>
                    </group>
                    <group string="Ações">
                        <button name="action_sincronizar_servidores"
                                type="object"
                                string="Sincronizar Servidores dos Dependentes(Clique estando dentro do responsavel financeiro que foi alterado as infos de porta)"
                                class="btn-primary"
                                attrs="{'invisible': [('id', '=', False)]}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
