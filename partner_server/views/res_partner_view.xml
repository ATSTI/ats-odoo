<?xml version="1.0"?>
<odoo>

    <!--  Partners inherited form -->
    <record id="view_res_campos_form" model="ir.ui.view">
        <field name="name">res.campos.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page name='tecnical_notes' string='Anotações Técnicas'>
                    <group string='Informações servidor'>
                        <field name='servidor'/>
                        <field name='obs_server'/>
                        <field name="porta_ids">
                            <tree string="Info porta" editable="bottom">
                                <field name="nporta"/>
                                <field name="rp_id" invisible="1"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath> 
        </field>
    </record>
</odoo>
