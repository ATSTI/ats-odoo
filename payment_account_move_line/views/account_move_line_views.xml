<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="receivable_payable_view_form" model="ir.ui.view">
		<field name="name">receivable_payabale.form</field>
		<field name="model">account.move.line</field>
		<field name="inherit_id" ref="account.view_move_line_form" />
		<field name="priority">999</field>
		<field name="arch" type="xml">
			<xpath expr="//form" position="replace">
				<form string="Itens do Diário" create="false">
					<sheet>
						<field name="company_id" invisible="1"/>
						<field name="parent_state" invisible="1"/>
						<group>
							<group>
								<field name="name" readonly="1"/>
								<field name="partner_id"
									domain="['|', ('parent_id', '=', False), ('is_company', '=', True)]"
									readonly="1"/>
							</group>
							<group string="Documentos Contábeis">
								<field name="move_id" readonly="1"/>
								<field name="statement_line_id"
									readonly="True"
									attrs="{'invisible': [('statement_line_id','=',False)]}"/>
							</group>
						</group>
						<notebook colspan="4">
							<page string="Informações Gerais" name="information">
								<group>
									<group string="Datas">
										<field name="date" groups="account.group_account_readonly"/>
										<field name="date_maturity" readonly="1"/>
									</group>
									<group string="Moeda" groups="base.group_multi_currency">
										<field name="currency_id" invisible="1"/>
										<field name="amount_currency" readonly="1"/>
									</group>
								</group>
								<group string="Valores" colspan="4">
									<group>
										<field name="account_id"
											options="{'no_create': True}"
											domain="[('company_id', '=', company_id)]"
											readonly="1"/>
										<field name="debit" readonly="1"/>
										<field name="credit" readonly="1"/>
									</group>
									<group>
										<field name="balance" readonly="1"/>
										<field name="quantity" readonly="1"/>
									</group>
								</group>
								<group>
									<group string="Impostos"
										attrs="{'invisible': [('tax_line_id','=',False), ('tax_ids','=',[])]}">
										<field name="tax_line_id" readonly="1"
											attrs="{'invisible': [('tax_line_id','=',False)]}"/>
										<field name="tax_ids" widget="many2many_tags" readonly="1"
											attrs="{'invisible': [('tax_ids','=',[])]}"/>
										<field name="tax_tag_invert" readonly="1" groups="base.group_no_one"/>
										<field name="tax_audit"/>
									</group>
									<group string="Conciliação"
										attrs="{'invisible':[('matched_debit_ids', '=', []),('matched_credit_ids', '=', [])]}">
										<label for="full_reconcile_id"/>
										<div>
											<field name="full_reconcile_id"
												attrs="{'invisible':[('full_reconcile_id','=',False)]}"/>
											<field name="matched_debit_ids" invisible="1"/>
											<field name="matched_credit_ids" invisible="1"/>
											<button name="open_reconcile_view"
												class="oe_link"
												type="object"
												string="→ Ver lançamentos parcialmente conciliados"
												attrs="{'invisible': ['|', ('full_reconcile_id', '!=', False),
																	'&amp;', ('matched_debit_ids', '=', []),
																	('matched_credit_ids', '=', [])]}"/>
										</div>
									</group>
								</group>
								<group>
									<group string="Produto"
										attrs="{'invisible': [('product_id', '=', False)]}">
										<field name="product_id" readonly="1"/>
									</group>
									<group string="Estados">
										<field name="blocked" readonly="1"/>
									</group>
									<group string="Analítico" groups="analytic.group_analytic_accounting">
										<field name="analytic_distribution"
											widget="analytic_distribution"
											readonly="1"/>
									</group>
								</group>
							</page>
							<page string="Linhas Analíticas"
								name="analytic_lines"
								groups="analytic.group_analytic_accounting">
								<field name="date" invisible="1"/>
								<field name="analytic_line_ids" readonly="1"
									context="{'tree_view_ref':'analytic.view_account_analytic_line_tree',
										'default_general_account_id':account_id,
										'default_name': name,
										'default_date':date,
										'amount': (debit or 0.0)-(credit or 0.0)}"
								/>
							</page>
						</notebook>
					</sheet>
				</form>
			</xpath>
		</field>
	</record>

	<record id="receivable_payable_view_tree" model="ir.ui.view">
		<field name="name">receivable_payabale.view.tree</field>
		<field name="model">account.move.line</field>
		<field name="arch" type="xml">
			<tree 
				default_order="date_maturity" 
				string="Pagamento" 
				decoration-danger="date_maturity&lt;current_date" 
				decoration-muted="reconciled==True" 
				create="false" 
				edit="false" 
				delete="false">

				<field name="currency_id" invisible="1"/>
				<field name="partner_id" readonly="1"/>
                <field name="account_id" readonly="1"/>
				<field name="name" string="Nota/Parcela" readonly="1"/>
				<field name="number_nfe" invisible="1" />
				<field name="company_currency_id" invisible="1"/>
                <field name="amount_currency" sum="Total das parcelas" />
                <field name="amount_residual" readonly="1" sum="Total"/>
                <field name="date_maturity"/>
				<!-- <field name="payment_date"/> -->
                <field name="move_id" readonly="1"/>
                <field name="reconciled" string="Pago" />

				<button name="action_register_payment_move_line"
                        type="object"
                        string="Pagar"
                        groups="account.group_account_invoice"
                        attrs="{'invisible': [('reconciled', '!=', False)]}"
                        class="btn btn-success"/>
			</tree>
		</field>
	</record>

	<record id="receivable_view_search" model="ir.ui.view">
		<field name="name">receivable_payable.view.search</field>
		<field name="model">account.move.line</field>
		<field name="arch" type="xml">
			<search string="Procurar">
                <filter 
					string="Contas em atraso" 
					domain="[('date_maturity','&lt;',time.strftime('%%Y-%%m-%%d')),('reconciled','=', False)]" 
					help="Contas em atraso" 
					name="overdue"/>
                <separator orientation="vertical"/>
                <filter 
					string="Recebido" 
					domain="[('reconciled','=', True)]" 
					help="Registros pagos" 
					name="paid"/>
                <filter 
					string="Aberto" 
					domain="[('reconciled','=', False)]" 
					help="Pagamentos em aberto" 
					name="open"/>
                <separator orientation="vertical"/>
				<field name="name" string="Nota/Parcela" />
				<field name="move_id" string="Lançamento" />
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="date_maturity"/>
                <group expand="0" string="Agrupar por...">
                    <filter 
						name="group_partner" 
						string="Parceiro" 
						domain="[]" 
						context="{'group_by':'partner_id'}"/>
                    <filter 
						name="group_date" 
						string="Dia Vencimento" 
						domain="[]" 
						context="{'group_by':'date_maturity:day'}"/>
                    <filter 
						name="group_month" 
						string="Data Vencimento" 
						domain="[]" 
						context="{'group_by':'date_maturity'}"/>
               </group>
           </search>
		</field>
	</record>

	<record id="payable_view_search" model="ir.ui.view">
		<field name="name">payable.view.search</field>
		<field name="model">account.move.line</field>
		<field name="arch" type="xml">
			<search string="Procurar">
                <filter 
					string="Contas em atraso" 
					domain="[('date_maturity','&lt;',time.strftime('%%Y-%%m-%%d')),('reconciled','=', False)]" 
					help="Contas em atraso" 
					name="overdue"/>
                <separator orientation="vertical"/>
                <filter 
					string="Pago" 
					domain="[('reconciled','=', True)]" 
					help="Registros pagos" 
					name="paid"/>
                <filter 
					string="Aberto" 
					domain="[('reconciled','=', False)]" 
					help="Pagamentos em aberto" 
					name="open"/>
                <separator orientation="vertical"/>
				<field name="number_nfe" string="Nota Fiscal" />
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="date_maturity"/>
                <group expand="0" string="Agrupar por...">
                    <filter 
						name="group_partner" 
						string="Parceiro" 
						domain="[]" 
						context="{'group_by':'partner_id'}"/>
                    <filter 
						name="group_date" 
						string="Data de Vencimento" 
						domain="[]" 
						context="{'group_by':'date_maturity:day'}"/>
                    <filter 
						name="group_month" 
						string="Mês" 
						domain="[]" 
						context="{'group_by':'date_maturity'}"/>
               </group>
           </search>
		</field>
	</record>

	<record id="view_move_line_menu_pivot" model="ir.ui.view">
		<field name="name">account.move.line.menu.pivot</field>
		<field name="model">account.move.line</field>
		<field name="arch" type="xml">
			<pivot string="Journal Items" sample="1">
				<field name="journal_id" type="row"/>
				<field name="date" type="col"/>
				<field name="balance" type="measure"/>
			</pivot>
		</field>
	</record>

	<record id="receivable_report_action" model="ir.actions.act_window">
		<field name="name">Contas Receber</field>
		<field name="res_model">account.move.line</field>
		<field name="view_mode">tree,form,pivot</field>
		<field name="view_id" ref="receivable_payable_view_tree"/>
        <field name="search_view_id" ref="receivable_view_search"/>
		<field name="context">{'search_default_open': 1}</field>
		<field name="domain">[
			('move_id.due_line_ids', '!=', 'False'),
			('account_id.account_type', '=', 'asset_receivable'),
			('partner_id', '!=', False),
			('debit', '&gt;', 0),('move_id.state', '=', 'posted'),
			]</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				Não há Registros de Contas Receber
			</p>
		</field>
	</record>

	<record id="payable_report_action" model="ir.actions.act_window">
		<field name="name">Contas Pagar</field>
		<field name="res_model">account.move.line</field>
		<field name="view_mode">tree,form,pivot</field>
		<field name="view_id" ref="receivable_payable_view_tree"/>
        <field name="search_view_id" ref="payable_view_search"/>
		<field name="context">{'search_default_open': 1}</field>
		<field name="domain">[
			('move_id.due_line_ids', '!=', 'False'),
			('account_id.account_type', '=', 'liability_payable'),
			('partner_id', '!=', False),
			('credit', '&gt;', 0),('move_id.state', '=', 'posted'),
			]</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				Não há Registros de Contas Pagar
			</p>
		</field>
	</record>

	<menuitem
		id="menu_receivable_payable_report"
		name="Contas Receber/Pagar"
		groups="account.group_account_invoice"
		parent="account.menu_finance"
		sequence="4"/>

	<menuitem
		id="menu_receivable_report"
		name="Contas Receber"
		action="receivable_report_action"
		groups="account.group_account_invoice"
		parent="menu_receivable_payable_report"
		sequence="1"/>

	<menuitem
		id="menu_payable_report"
		name="Contas Pagar"
		action="payable_report_action"
		groups="account.group_account_invoice"
		parent="menu_receivable_payable_report"
		sequence="2"/>
</odoo>
