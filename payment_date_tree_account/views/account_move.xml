<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_tree_payment_date" model="ir.ui.view">
        <field name="name">account.move.tree.payment.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <!-- Altera os atributos do campo invoice_date_due -->
            <field name="invoice_date_due" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="widget">date</attribute>
            </field>
            
            <!-- Adiciona o campo payment_date logo após -->
            <field name="invoice_date_due" position="after">
                <field name="payment_date" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
