<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_free_access_inherit" model="ir.ui.view">
        <field name="name">account_move.form.free_access.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//div[@class='o_td_label']" position="after">
                <field name="free_access" string="Liberar Acesso"/>
            </xpath>
        </field>
    </record>
</odoo>
