<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_separacao_cega_gerente">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="o.name"/>
                        </h2>

                        <div class="row mt-4 mb-4">
                            <div t-if="o.origin" class="col-auto col-3 mw-100 mb-2">
                                <strong>Pedido:</strong>
                                <p t-field="o.origin" class="m-0"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>Separador:</strong>
                                <p t-field="o.separador_id" class="m-0"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>Conferente:</strong>
                                <p t-field="o.conferente_id" class="m-0"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>Data:</strong>
                                <p t-field="o.scheduled_date" class="m-0"/>
                            </div>
                        </div>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th><strong>Produto</strong></th>
                                    <th class="text-center"><strong>Conferência</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="moves" t-value="o.move_ids_without_package.filtered(lambda m: m.state not in ('cancel',))"/>
                                <tr t-foreach="moves" t-as="move">
                                    <td>
                                        <span t-field="move.product_id"/>
                                    </td>
                                    <td class="text-center">
                                        <!-- mostra só se conferido e bateu, senão linha em branco -->
                                        <t t-if="move.conferencia and move.conferencia == move.product_uom_qty">
                                            <span t-esc="move.conferencia"/>
                                            <span t-field="move.product_uom"/>
                                        </t>
                                        <t t-else="">
                                            <div style="border-bottom:1px solid black; height:18px; width:80px; margin: auto;"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <record id="action_report_separacao_cega_gerente" model="ir.actions.report">
        <field name="name">Operação de Separação às Cegas (Gerente de Inventário)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">picking_soloz_custom.report_separacao_cega_gerente</field>
        <field name="report_file">picking_soloz_custom.report_separacao_cega_gerente</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_manager'))]"/>
    </record>
</odoo>