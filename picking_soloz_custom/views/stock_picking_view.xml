<odoo>
    <record id="view_picking_soloz_form" model="ir.ui.view">
        <field name="name">stock.picking.soloz</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/header" position="inside">
                <button
                    name="action_transito"
                    type="object"
                    string="Enviar para Transporte"
                    class="btn-primary"
                    states="done"
                />
                <button
                    name="action_entregue"
                    type="object"
                    string="Marcar como Entregue"
                    class="btn-success"
                    states="transito"
                />

                <button
                    name="action_agrupar_linhas"
                    type="object"
                    string="Agrupar Linhas"
                    class="btn-primary"
                    states="draft,confirmed"

                />

            </xpath>
        
        </field>
    </record>
</odoo>