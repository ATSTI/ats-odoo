<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-receipt')]" position="replace">
            <div class='pos-receipt'>
                <h4 style="font-size: 32px; font-weight: bold; margin-bottom: 20px;">Itens do Pedido:</h4>
                <hr style="border: 3px dashed #000; margin-bottom: 20px;"/>
                <t t-foreach="receipt.orderlines" t-as="line" t-key="line.id">
                    <b style="font-size: 28px; font-weight: bold; display: block; margin-bottom: 10px;">Clube Recreativo São Pedro</b>
                    <div style="font-size: 22px; margin-top: 12px; margin-bottom: 10px;">
                        Servido Por: <t t-esc="receipt.cashier"/>
                    </div>
                    <div style="font-size: 24px; margin-bottom: 30px; line-height: 1.6; font-weight: bold;"> 
                        <t t-esc="line.product_name_wrapped[0]"/> <br/>
                        Qtde.: <t t-esc="line.quantity"/>
                    </div>
                    <hr style="border: 2px dashed #000; margin: 20px 0;"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>
