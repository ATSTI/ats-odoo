<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="purchase_discount_value_view_form" model="ir.ui.view">
            <field name="name">purchase.discount.value.view.form</field>
            <field name="model">purchase.order</field>
            <field name="priority">999</field>
            <field name="inherit_id" ref="l10n_br_purchase.l10n_br_purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="before">
                    <button string="Approve" type="object" name="action_approve" states="waiting" class="oe_highlight"
                            groups="purchases_team.group_purchase_manager"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="before">
                    <button string="Approve" type="object" name="action_approve" states="waiting" class="oe_highlight"
                            groups="purchases_team.group_purchase_manager"/>
                </xpath>
                <xpath expr="//field[@name='notes']" position="after">
                    <group name="note_group" col="6">
                        <group name="discount" colspan="4">
                            <field name="discount_type"/>
                            <!-- <field name="discount_rate" readonly="1" /> -->
                            <label for="discount_rate_t" />
                            <div class="o_row">
                                <field name="discount_rate_t"/>
                                <button name="button_dummy"
                                    states="draft,sent" string="Atualizar" type="object"
                                    class="oe_edit_only btn-primary"/>
                            </div>
                            <field name="discount_rate" string="Percentual" readonly="1" />
                        </group>
                    </group>
                </xpath>
                <xpath expr="//field[@name='order_line']/form//field[@name='discount_value']" position="before">
                        <label for="discount_type">Tipo de Desconto:</label>
                        <div>
                            <field name="discount_type" />
                            <field name="discount_rate_t" />
                            <button name="button_update_discount"
                                states="draft,sent" string="Atualizar" type="object"
                                class="oe_edit_only btn-primary"/>
                        </div>    
                </xpath>
                <xpath expr="//field[@name='order_line']/form//field[@name='discount_value']" position="replace">
                    <field name="discount_value" readonly="1"/>
                    <field name="amount_total" />
                </xpath>
                <!-- Roundoff the discount field -->
                <!-- <xpath expr="//field[@name='order_line']/tree/field[@name='discount']" position="attributes">
                    <attribute name="digits">[16, 2]</attribute>
                </xpath> -->
            </field>
        </record>
</odoo>
