<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="frete_report">
        <t t-call="account_financial_report.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="account_financial_report.internal_layout">
                    <t t-call="relatorio_frete.report_frete_report_base" />
                </t>
            </t>
        </t>
    </template>
    <template id="relatorio_frete.report_frete_report_base">
        <t t-set="title">
            Receitas/Despesas de Frete
        </t>
        <t t-set="company_name" t-value="company_name" />
        <div class="page">
            <div class="row">
                <h4
                    class="mt0"
                    t-esc="title or 'Odoo Report'"
                    style="text-align: center;"
                />
            </div>
            <!-- Display filters -->
            <t t-call="relatorio_frete.report_frete_report_filters" />
            <div class="page_break" />
            <div class="act_as_table data_table" style="width: 100%;">
                <!-- Display table headers for lines -->
                <div class="act_as_thead">
                    <div class="act_as_row labels">
                        <!--## code-->
                        <div class="act_as_cell first_column" style="width: 8%;">
                            Fatura
                        </div>
                        <!--## name-->
                        <div class="act_as_cell" style="width: 7%;">Documento</div>
                        <!--## net-->
                        <div class="act_as_cell" style="width: 65%;">Parceiro</div>
                        <!--## tax-->
                        <div class="act_as_cell" style="width: 15%;">Valor Frete/Receita</div>
                    </div>
                </div>
                <t t-set="resultado_geral" t-value="0" />
                <t t-foreach="frete_report" t-as="tag_or_group">
                    <t t-set="resultado" t-value="0" />
                    <div class="act_as_row lines" style="font-weight: bold;">
                        <div
                            class="act_as_cell left oe_tooltip_string"
                            style="width: 5%;"
                        >
                            <span
                                t-att-res-id="res_id"
                                t-att-res-model="res_model"
                                view-type="form"
                            >
                                <t t-att-style="style" t-out="tag_or_group['name']" />
                            </span>
                        </div>                        
                        <div
                            class="act_as_cell left oe_tooltip_string"
                            style="width: 5%;"
                        >
                            <span
                                t-att-res-id="res_id"
                                t-att-res-model="res_model"
                                view-type="form"
                            >
                                <t t-att-style="style" t-out="tag_or_group['document_number']" />
                            </span>
                        </div>                        
                        <div
                            class="act_as_cell left oe_tooltip_string"
                            style="width: 65%;"
                        >
                            <span
                                t-att-res-id="res_id"
                                t-att-res-model="res_model"
                                view-type="form"
                            >
                                <t t-att-style="style" t-out="tag_or_group['partner_id']" />
                            </span>
                        </div>
                        <div class="act_as_cell amount" style="width: 15%;">
                            <t
                                t-att-style="style"
                                t-out="tag_or_group['balance']"
                                t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                            />
                        </div>
                    </div>
                    <!-- <div class="act_as_row">
                        <div class="act_as_cell">
                            Data
                        </div>
                        <div class="act_as_cell">
                            Pedido
                        </div>
                        <div class="act_as_cell left oe_tooltip_string">
                            Cliente
                        </div>
                        <div class="act_as_cell">
                        </div>
                    </div> -->
                    <t t-set="resultado" t-value="resultado - tag_or_group['balance']" />
                    <t t-set="resultado_geral" t-value="resultado_geral - tag_or_group['balance']" />
                    <t t-foreach="notas" t-as="nota">
                        <t t-if="nota['despesa_id'] == tag_or_group['move_id']">
                            <t t-set="resultado" t-value="resultado + nota['amount_freight_value']" />
                            <t t-set="resultado_geral" t-value="resultado_geral + nota['amount_freight_value']" />
                            <div class="act_as_row">
                                <div
                                    class="act_as_cell left oe_tooltip_string"
                                    style="width: 8%;"
                                >
                                    <span t-out="nota['document_date']" />
                                </div>
                                <div
                                    class="act_as_cell left oe_tooltip_string"
                                    style="width: 7%;"
                                >
                                     <span t-out="nota['sale_id']" />
                                </div>
                                <div
                                    class="act_as_cell left oe_tooltip_string"
                                    style="width: 65%;"
                                >
                                     <span t-out="nota['partner_id']" />
                                </div>                                
                                <div class="act_as_cell amount" style="width: 15%;">
                                    <t
                                        t-att-style="style"
                                        t-out="nota['amount_freight_value']"
                                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                                    />                                    
                                </div>
                            </div>                          
                        </t>
                    </t>
                    <!-- resultado -->
                    <div class="act_as_row">
                        <div class="act_as_cell">
                        </div>
                        <div class="act_as_cell">
                        </div>
                        <div class="act_as_cell right">
                            Resultado:
                        </div>                                
                        <div class="act_as_cell amount" style="width: 15%;">
                            <t
                                t-att-style="style"
                                t-esc="resultado"
                                t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                            />                                    
                        </div>
                    </div>
                    <div class="row" />
                </t>
                <!-- resultado Geral -->
                <div class="act_as_row">
                    <div class="act_as_cell">
                    </div>
                    <div class="act_as_cell">
                    </div>
                    <div class="act_as_cell right">
                        Resultado Geral:
                    </div>                                
                    <div class="act_as_cell amount" style="width: 15%;">
                        <t
                            t-att-style="style"
                            t-esc="resultado_geral"
                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                        />                                    
                    </div>
                </div>                 
            </div>
        </div>
    </template>
    <template id="relatorio_frete.report_frete_report_filters">
        <div class="act_as_table data_table" style="width: 100%;">
            <div class="act_as_row labels">
                <div class="act_as_cell">Date From</div>
                <div class="act_as_cell">Date To</div>
            </div>
            <div class="act_as_row">
                <div class="act_as_cell">
                    <span t-esc="date_from" t-options="{'widget': 'date'}" />
                </div>
                <div class="act_as_cell">
                    <span t-esc="date_to" t-options="{'widget': 'date'}" />
                </div>
            </div>
        </div>
    </template>
</odoo>
