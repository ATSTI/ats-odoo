<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_calhassilva_template">
    <t t-name="service_template">
        <t t-call="web.external_layout">            
            <t t-foreach="docs" t-as="doc">
                <style>
                    * {
                        margin: 0;
                        padding: 0;
                        box-sizing: border-box;
                        text-transform: uppercase;
                        font-family: Arial, sans-serif;
                    }
                    .company, .client, .service, .data_receipt, .signature {
                        width: 100%;
                        border-collapse: collapse;
                    }
                    .logo { width: 20%; border: thin solid black; padding: 2px; }
                    .address { width: 50%; border: thin solid black; padding: 8px; font-size: 12px; }
                    .shipping { width: 28%; border: thin solid black; padding: 8px; font-size: 12px; }
                    .data_receipt td, .service td, .signature td { border: thin solid black; text-align: center; font-size: 12px; padding: 4px; }
                    .service td { vertical-align: middle; }
                    #items_head td { font-weight: bold; background-color: #f2f2f2; }
                    .message { width: 100%; border: thin solid black; font-size: 9px; padding: 5px; margin-top: 5px; }
                    .dashed { width: 100%; border-top: 1px dashed black; margin: 7px 0; }
                    .signature td { font-size: 10px; padding: 4px; }
                </style>

                <main>
                    <div class="page" style ='padding-top:10%'>
                        <table class="company">
                            <tr>
                                <td class="logo">
                                    <img t-if="doc.company_id.logo" t-attf-src="data:image/png;base64,#{doc.company_id.logo}" width="120"/>
                                </td>
                                <td class="address">
                                    <h4 t-field="doc.company_id.name"/>
                                    <span t-field="doc.company_id.street_name"/>, <span t-field="doc.company_id.street_number"/> - <span t-field="doc.company_id.district"/><br/>
                                    CEP: <span t-field="doc.company_id.zip"/> - <span t-field="doc.company_id.city_id"/> - <span t-field="doc.company_id.state_id.code"/><br/>
                                    FONES: <span t-field="doc.company_id.phone"/>
                                </td>
                                <td class="shipping">
                                    <h3>RECIBO Nº: <span t-field="doc.name"/></h3>
                                    <h6>CNPJ: <span t-field="doc.company_id.cnpj_cpf"/></h6>
                                    <h6>Inscr. Municipal: <span t-field="doc.company_id.inscr_mun"/></h6>
                                    <h6>Inscr. Estadual: <span t-field="doc.company_id.inscr_est"/></h6>
                                    <h6>NAT. DA OPERAÇÃO: LOCAÇÃO</h6>
                                    <h6>DATA DE EMISSÃO: <span t-field="doc.invoice_date"/></h6>
                                </td>
                            </tr>
                        </table>
                        <table class="data_receipt" style="margin-top:10px;">
                            <tr>
                                <td>Nº DA FATURA</td>
                                <td>VALOR R$</td>
                                <td>DUPLICATA</td>
                                <td>VENCIMENTO</td>
                                <td rowspan="2" id="receipt"><strong><span t-field="doc.ref"/></strong></td>
                            </tr>
                            <tr>
                                <td><span t-field="doc.name"/></td>
                                <td><span t-field="doc.amount_total"/></td>
                                <td><span t-field="doc.ref"/></td>
                                <td><span t-field="doc.invoice_date_due"/></td>
                            </tr>
                        </table>
                        <table class="client" style="margin-top:5px;">
                            <tr>
                                <td>CLIENTE: <span t-field="doc.partner_id.name"/></td>
                            </tr>
                            <tr>
                                <td>ENDEREÇO: <span t-field="doc.partner_id.street"/></td>
                                <td>BAIRRO: <span t-field="doc.partner_id.district"/></td>
                            </tr>
                            <tr>
                                <td>MUNICÍPIO: <span t-field="doc.partner_id.city_id"/></td>
                                <td>CEP: <span t-field="doc.partner_id.zip"/></td>
                                <td>ESTADO: <span t-field="doc.partner_id.state_id"/></td>
                            </tr>
                            <tr>
                                <td>CNPJ/CPF: <span t-field="doc.partner_id.cnpj_cpf"/></td>
                                <td>I.E.: <span t-field="doc.partner_id.inscr_est"/></td>
                            </tr>
                        </table>
                        <table class="service" style="margin-top:5px;">
                            <tr id="items_head">
                                <td>UNIDADE</td>
                                <td>QUANTIDADE</td>
                                <td>DISCRIMINAÇÃO DOS SERVIÇOS</td>
                                <td>UNITÁRIO</td>
                                <td>TOTAL</td>
                            </tr>
                            <t t-set="category" t-value="False"/>
                            <t t-set="uom" t-value=""/>
                            <t t-set="qty" t-value="0"/>
                            <t t-set="price" t-value="0.0"/>
                            <t t-foreach="doc.invoice_line_ids" t-as="line">
                                <t t-if="category and category != line.product_id.categ_id.name">
                                    <tr>
                                        <td><span t-esc="uom"/></td>
                                        <td><span t-esc="'%.1f' % qty"/></td>
                                        <td><span t-esc="category"/></td>
                                        <td><span t-esc="price/qty" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td><span t-esc="price" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <t t-set="qty" t-value="0"/>
                                    <t t-set="price" t-value="0.0"/>
                                    <t t-set="uom" t-value=""/>
                                </t>
                                <t t-set="qty" t-value="qty+line.quantity"/>
                                <t t-set="price" t-value="price+line.price_subtotal"/>
                                <t t-set="category" t-value="line.product_id.categ_id.name"/>
                                <t t-set="uom" t-value="line.product_uom_id.name"/>
                            </t>
                            <tr>
                                <td><span t-esc="uom"/></td>
                                <td><span t-esc="'%.1f' % qty"/></td>
                                <td><span t-esc="category"/></td>
                                <td><span t-esc="price/qty" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td><span t-esc="price" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                            <tr>
                                <td colspan="4">VALOR TOTAL</td>
                                <td><span t-field="doc.amount_total"/></td>
                            </tr>
                        </table>

                        <div class="message">
                            A importância desta fatura de locação corresponde à prestação de serviços conforme discriminado acima. O pagamento deverá ser feito a <span t-field="doc.company_id.name"/>.
                        </div>

                        <div class="dashed"/>

                        <table class="signature">
                            <tr>
                                <td>DATA DO RECEBIMENTO:<br/><br/><br/></td>
                                <td>IDENTIFICAÇÃO/ASSINATURA DO RECEBEDOR:<br/><br/><br/></td>
                                <td rowspan="2" id="receipt"><strong><span t-field="doc.ref"/></strong></td>
                            </tr>
                        </table>

                        <div style="margin-top: 10px; font-size: 8px; color: #5c5c5c">
                            Powered By ATSTi Soluções - www.atsti.com.br
                        </div>
                    </div>
                </main>
            </t>
        </t>
    </t>
  </template>
</odoo>
