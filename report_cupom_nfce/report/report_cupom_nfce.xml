<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cupom_nfce_document" inherit_id="l10n_br_nfe.report_danfe_nfce">
        <xpath expr="//t[@t-call='web.html_container']" position="replace">
            <t t-call="web.html_container">
                <div style="font-size: 12px; max-width: 80mm; margin: 0 auto;">

                    <!-- HEADER -->
                    <div style="text-align: center;">
                        <h2 style="font-size: 16px; margin: 0;"><t t-esc="company_name"/></h2>
                        <p style="margin: 0;"><t t-esc="company_legal_name"/></p>
                        <p style="margin: 0;">
                            <t t-esc="company_street"/>, 
                            <t t-esc="company_district"/>, 
                            <t t-esc="company_city"/> - 
                            <t t-esc="company_state"/>
                        </p>

                        <table style="width:100%; font-size:12px;">
                            <tr>
                                <td style="text-align:left;">CNPJ: <t t-esc="company_cnpj"/></td>
                                <td style="text-align:right;">IE: <t t-esc="company_ie"/></td>
                            </tr>
                        </table>

                        <p style="margin-top:5px;">
                            Documento Auxiliar da Nota Fiscal do Consumidor Eletrônica
                        </p>

                        <t t-if="contingency">
                            <p style="margin:0;">Emitida em Contingência</p>
                            <p style="margin:0;">Pendente de Autorização</p>
                        </t>

                        <t t-if="homologation_environment">
                            <p style="margin:0;">
                                EMITIDA EM AMBIENTE DE HOMOLOGAÇÃO - SEM VALOR FISCAL
                            </p>
                        </t>
                    </div>

                    <hr/>

                    <!-- ITENS -->
                    <table style="width:100%; border-collapse: collapse; font-size:12px;">
                        <tr>
                            <th style="text-align:left;">COD</th>
                            <th style="text-align:left;">DESCRIÇÃO</th>
                            <th style="text-align:right;">QTD</th>
                            <th style="text-align:center;">UN</th>
                            <th style="text-align:right;">VL UNIT</th>
                            <th style="text-align:right;">VL TOTAL</th>
                        </tr>

                        <t t-foreach="lines" t-as="line">
                            <tr>
                                <td><t t-esc="line['product_index']"/></td>
                                <td><t t-esc="line['product_name']"/></td>
                                <td style="text-align:right;"><t t-esc="line['product_quantity']"/></td>
                                <td style="text-align:center;"><t t-esc="line['product_uom']"/></td>
                                <td style="text-align:right;">
                                    <t t-esc="line['product_unit_value']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td style="text-align:right;">
                                    <t t-esc="line['product_unit_total']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                        </t>
                    </table>

                    <hr/>

                    <!-- TOTAIS -->
                    <table style="width:100%; font-size:12px;">
                        <tr>
                            <td style="text-align:left;">Qtd total itens:</td>
                            <td style="text-align:right;"><t t-esc="total_product_quantity"/></td>
                        </tr>

                        <t t-if="unformatted_amount_discount_value">
                            <tr>
                                <td style="text-align:left;">Desconto:</td>
                                <td style="text-align:right;"><t t-esc="unformatted_amount_discount_value"/></td>
                            </tr>
                        </t>

                        <tr>
                            <td style="font-weight:bold;">VALOR TOTAL:</td>
                            <td style="text-align:right; font-weight:bold;">
                                <t t-esc="amount_total" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                        </tr>
                    </table>

                    <hr/>

                    <!-- PAGAMENTOS -->
                    <table style="width:100%; font-size:12px;">
                        <t t-foreach="payments" t-as="payment">
                            <tr>
                                <td><t t-esc="payment['method']"/></td>
                                <td style="text-align:right;">
                                    <t t-esc="payment['value']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                        </t>

                        <t t-if="amount_change">
                            <tr>
                                <td>Troco:</td>
                                <td style="text-align:right;"><t t-esc="amount_change"/></td>
                            </tr>
                        </t>
                    </table>

                    <hr/>

                    <!-- CHAVE -->
                    <div style="text-align:center;">
                        <p style="margin:0;">Consulte pela chave de acesso em:</p>
                        <p style="margin:0;"><t t-esc="nfce_url"/></p>
                        <p style="margin:0;"><t t-esc="document_key"/></p>
                    </div>

                    <hr/>

                    <!-- RODAPÉ -->
                    <table style="width:100%; font-size:12px;">
                        <tr>
                            <td style="width:60%; vertical-align:top;">
                                <t t-if="partner_cpf">
                                    <p style="margin:0;">CNPJ/CPF: <t t-esc="partner_cpf"/></p>
                                </t>
                                <t t-if="not partner_cpf">
                                    <p style="margin:0;">CONSUMIDOR NÃO IDENTIFICADO</p>
                                </t>

                                <p style="margin:0;">Número: <t t-esc="document_number"/></p>
                                <p style="margin:0;">Série: <t t-esc="document_serie"/></p>
                                <p style="margin:0;">Emissão: <t t-esc="document_date"/></p>

                                <t t-if="contingency">
                                    <p style="margin:0;">Emitida em Contingência</p>
                                </t>
                                <t t-else="">
                                    <p style="margin:0;">Protocolo: <t t-esc="authorization_protocol"/></p>
                                    <p style="margin:0;">Autorização: <t t-esc="document_date"/></p>
                                </t>
                            </td>

                            <td style="width:40%; text-align:right;">
                                <t t-if="document_qrcode">
                                    <img t-att-src="'https://api.qrserver.com/v1/create-qr-code/?size=120x120&amp;data=%s' % document_qrcode"/>
                                </t>
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </xpath>
    </template>
</odoo>
