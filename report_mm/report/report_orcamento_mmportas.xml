<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_orcamento_mm" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.external_layout">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                <style>
                    .o_line_section {
                        background-color: #f8f9fa !important; /* cinza claro */
                        color: #000 !important;
                    }
                </style>
    
                <div class="header" style="width:100%; text-align:center; margin-bottom:20px;">
                    <table style="width:100%; border:0; font-size:12px; font-family: Arial, sans-serif; margin-bottom:10px;">
                        <tr>
                            <td style="width:40%; vertical-align:top; padding:0;">
                                <img t-attf-src="data:image/*;base64,{{doc.company_id.logo}}"
                                     t-att-alt="doc.company_id.name"
                                     style="max-width:300px; max-height:225px; display:block;"/>
                            </td>
                            <td style="width:100%; text-align:right; vertical-align:top; padding:0; font-size:15px;">
                                <strong><span t-field="doc.company_id.name"/></strong><br/>
                                CNPJ/CPF: <span t-field="doc.company_id.cnpj_cpf"/><br/>
                                <span t-field="doc.company_id.street_name"/>, 
                                <span t-field="doc.company_id.street_number"/> - 
                                <span t-field="doc.company_id.district"/>, CEP: 
                                <span t-field="doc.company_id.zip"/> - 
                                <span t-field="doc.company_id.state_id.code"/><br/>
                                <span t-field="doc.company_id.phone"/> | 
                                <span t-field="doc.company_id.email"/>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="footer" style="width:100%; font-size:15px; text-align:center; margin-top:20px;">
                    <hr style="border:none; border-top:1px solid #999; margin:5px 0;"/>
                    <t t-if="doc.company_id.instagram_png">
                        <img t-attf-src="data:image/*;base64,{{doc.company_id.instagram_png}}" style="width:20px; height:20px; vertical-align:middle; margin-right:5px;"/>
                    </t>
                    <span style="margin-right:25px;">mmportasinternas</span>
                    <t t-if="doc.company_id.whatsapp_png">
                        <img t-attf-src="data:image/*;base64,{{doc.company_id.whatsapp_png}}" style="width:20px; height:20px; vertical-align:middle; margin-right:5px;"/>
                    </t>
                    <span style="margin-right:25px;">(19) 99662-1524</span>
                    <t t-if="doc.company_id.email_png">
                        <img t-attf-src="data:image/*;base64,{{doc.company_id.email_png}}" style="width:20px; height:20px; vertical-align:middle; margin-right:5px;"/>
                    </t>
                    <span>contato@mmportasinternas.com.br</span>
                </div>
                <div class="page" style ='padding-top:10%;'>
                    <div class="oe_structure"/>
                    <h2 class="mt-4">
                        <span t-if="env.context.get('proforma', False) or is_pro_forma">Pro-Forma Invoice # </span>
                        <span t-elif="doc.state in ['draft','sent']">Orçamento # </span>
                        <span t-else="">Pedido # </span>
                        <span t-field="doc.name"/>
                    </h2>
                    <div class="mt-3 mb-3">
                        <div t-field="doc.partner_id" 
                             t-options="{'widget': 'contact', 'fields': ['address','name'], 'no_marker': True}"/>
                        <p t-if="doc.partner_id.vat">
                            <t t-out="doc.company_id.account_fiscal_country_id.vat_label or 'Tax ID'"/>:
                            <span t-field="doc.partner_id.vat"/>
                        </p>

                        <t t-if="doc.partner_shipping_id == doc.partner_invoice_id and doc.partner_invoice_id != doc.partner_id or doc.partner_shipping_id != doc.partner_invoice_id">
                            <strong>
                                <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">
                                    Fatura e endereço de entrega:
                                </t>
                                <t t-else="">
                                    Endereço de faturamento:
                                </t>
                            </strong>
                            <div t-field="doc.partner_invoice_id" 
                                 t-options="{'widget': 'contact','fields': ['address','name','phone'],'no_marker': True,'phone_icons': True}"/>
                            <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">
                                <strong>Endereço de entrega:</strong>
                                <div t-field="doc.partner_shipping_id" 
                                     t-options="{'widget': 'contact','fields': ['address','name','phone'],'no_marker': True,'phone_icons': True}"/>
                            </t>
                        </t>
                    </div>
                    <div class="row mt-4 mb-4" id="informations">
                        <div t-if="doc.client_order_ref" class="col-auto col-3 mw-100 mb-2" name="informations_reference">
                            <strong>Cliente:</strong>
                            <p class="m-0" t-field="doc.client_order_ref"/>
                        </div>
                        <div t-if="doc.date_order" class="col-auto col-3 mw-100 mb-2" name="informations_date">
                            <strong t-if="doc.state in ['draft', 'sent']">Data de orçamento:</strong>
                            <strong t-else="">Data do pedido:</strong>
                            <p class="m-0" t-field="doc.date_order" t-options="{'widget': 'date'}"/>
                        </div>
                        <div t-if="doc.validity_date and doc.state in ['draft', 'sent']" class="col-auto col-3 mw-100 mb-2" name="expiration_date">
                            <strong>Expiração:</strong>
                            <p class="m-0" t-field="doc.validity_date"/>
                        </div>
                        <div t-if="doc.user_id.name" class="col-auto col-3 mw-100 mb-2">
                            <strong>Vendedor:</strong>
                            <p class="m-0" t-field="doc.user_id"/>
                        </div>
                    </div>

                    <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
                    <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>

                    <table class="table table-sm o_main_table table-borderless mt-4">
                        <thead>
                            <tr>
                                <th class="text-start">Descrição</th>
                                <th class="text-end">Quantidade</th>
                                <th class="text-end">Preço Unitário</th>
                                <th t-if="display_discount" class="text-end">Disc.%</th>
                                <th class="text-end" style="width:0.01%; font-size:1px; color:transparent;">Taxes</th> 
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>

                        <tbody class="sale_tbody">
                            <t t-foreach="lines_to_report" t-as="line">
                                <tr t-att-class="'bg-light fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                    <t t-if="not line.display_type">
                                        <td class="text-start"><span t-field="line.name"/></td>
                                        <td class="text-end">
                                            <span t-field="line.product_uom_qty"/>
                                            <span t-field="line.product_uom"/>
                                        </td>
                                        <td class="text-end"><span t-field="line.price_unit"/></td>
                                        <td t-if="display_discount" class="text-end"><span t-field="line.discount"/></td>

                                        <td class="text-end" style="padding:0; margin:0; border:none; width:0.01%; font-size:0; line-height:0; color:transparent;">
                                            <span t-if="False" t-field="line.tax_ids"/>
                                        </td>

                                        <td class="text-end o_price_total">
                                       <span t-field="line.price_total" t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'/>
                                        </td>
                                    </t>

                                    <t t-elif="line.display_type == 'line_section'">
                                        <tr t-att-style="'background-color: #d6d8db; font-weight: bold; color: #000;'">
                                            <td colspan="99" t-att-style="'border: 2px solid #000; padding: 6px;'">
                                                <span t-field="line.name"/>
                                            </td>
                                        </tr>
                                    </t> <!--Aqui que altera a cor da secao, ver se eles aprova assim-->


                                    <t t-elif="line.display_type == 'line_note'">
                                        <td colspan="99"><span t-field="line.name"/></td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="clearfix" name="so_total_summary">
                        <div id="total" class="row" name="total">
                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td style="background-color: #37b18c; color: white; padding: 10px; font-weight: bold; display: flex; justify-content: space-between;">
                                            <span>Total:</span>
                                            <span t-field="doc.amount_total"
                                                  t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'
                                                  style="color: white; font-weight: bold;"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div t-if="doc.signature" class="mt-4 ml64 mr4" name="signature">
                        <div class="offset-8"><strong>Assinatura</strong></div>
                        <div class="offset-8">
                            <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                        </div>
                        <div class="offset-8 text-center">
                            <p t-field="doc.signed_by"/>
                        </div>
                    </div>
                    <div>
                        <p t-field="doc.note" name="order_note"/>
                        <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)" id="fiscal_position_remark">
                            <strong>Posição Fiscal:</strong>
                            <span t-field="doc.fiscal_position_id.sudo().note"/>
                        </p>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
