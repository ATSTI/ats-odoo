<odoo>
    <record id="locefaca_product_normal_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='invoice_tab']//field[@name='narration']" position="after">
                <field name="evento"/>
            </xpath>

            <!-- Correção aqui: adicionado o <group> para forçar a quebra de linha correta -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="data_limite"/>
            </xpath>
        </field>
    </record>
</odoo>
