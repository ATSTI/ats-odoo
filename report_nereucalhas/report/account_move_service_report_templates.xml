<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_nereu_template">
    <t t-call="web.external_layout">
      <t t-foreach="docs" t-as="o">
        <style>
          * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
            text-transform: uppercase;
          }
          .page {
            width: 100%;
            padding: 20px;
          }
          .section-title {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 5px;
          }
          .client-info, .order-info {
            width: 48%;
            display: inline-block;
            vertical-align: top;
          }
          .client-info span, .order-info span {
            display: block;
            font-size: 12px;
            margin: 2px 0;
          }
          .order-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
          }
          .order-table th, .order-table td {
            border: 1px solid #000;
            padding: 6px;
            font-size: 12px;
          }
          .order-table th {
            background-color: #f2f2f2;
            font-weight: bold;
          }
          .order-table td {
            text-align: center;
          }
          .order-table td.text-left {
            text-align: left;
          }
          .total-table {
            width: 40%;
            float: right;
            margin-top: 15px;
            border-collapse: collapse;
          }
          .total-table td {
            padding: 6px;
            font-size: 14px;
          }
          .total-label {
            text-align: left;
            font-weight: bold;
          }
          .total-value {
            text-align: right;
            font-weight: bold;
            background-color: #939595;
            color: #fff;
          }
          .reference {
            margin-top: 15px;
            font-size: 12px;
          }
        </style>

        <main>
          <div class="page">
            <div style="margin-bottom: 20px; border-bottom: 1px dashed #000;"></div>

            <div class="client-info">
              <div class="section-title">Dados do Cliente:</div>
              <span t-field="o.partner_id.name"/>
              <span t-field="o.partner_id.cnpj_cpf"/>
              <span>
                <span t-field="o.partner_id.street_name"/> - 
                <span t-field="o.partner_id.street_number"/> - 
                <span t-field="o.partner_id.city_id.name"/> - 
                <span t-field="o.partner_id.district"/> - 
                <span t-field="o.partner_id.state_id.name"/>
              </span>
            </div>
            <div class="order-info">
              <div class="section-title">Pedido:</div>
              <span>Nº <span t-field="o.name"/></span>
              <span>Data do Pedido: <span t-field="o.effective_date"/></span>
              <span>Vendedor: <span t-field="o.user_id"/></span>
            </div>

            <div class="reference">
              <b>Referência:</b> <span t-field="o.client_order_ref"/>
            </div>

            <table class="order-table">
              <tr>
                <th>Data</th>
                <th>Descrição</th>
                <th>Qntd</th>
                <th>Preço Total</th>
              </tr>
              <t t-foreach="o.order_line" t-as="line">
                <tr t-att-class="'bg-200 font-weight-bold' if line.display_type == 'line_section' else 'font-italic' if line.display_type == 'line_note' else ''">
                  <t t-if="not line.display_type">
                    <td class="text-left"><span t-field="line.create_date" t-options='{"widget": "date"}'/></td>
                    <td class="text-left"><span t-field="line.name"/></td>
                    <td><span t-field="line.product_uom_qty"/> <span t-field="line.product_uom"/></td>
                    <td><span t-field="line.price_subtotal"/></td>
                  </t>
                  <t t-if="line.display_type in ['line_section','line_note']">
                    <td colspan="4"><span t-field="line.name"/></td>
                  </t>
                </tr>
              </t>
            </table>

            <table class="total-table">
              <tr>
                <td class="total-label">Subtotal</td>
                <td class="text-right"><span t-field="o.amount_untaxed"/></td>
              </tr>
              <tr>
                <td class="total-label">Total</td>
                <td class="total-value"><span t-field="o.amount_total"/></td>
              </tr>
            </table>
          </div>
        </main>
      </t>
    </t>
  </template>
</odoo>
