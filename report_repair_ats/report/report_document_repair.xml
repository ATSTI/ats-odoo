<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_repair_document">
        <t t-name="account_move_service_report.report_service_template">
            <t t-name="service_template">
                <t t-call="web.external_layout">
                    <t t-foreach="docs" t-as="doc">
                        <style>
                            *{
                                margin: 0;
                                padding: 0;
                                box-sizing: border-box;
                                text-transform: uppercase;
                                font-size: 10px; 
                            }
                            .company{
                                width: 100%;
                            }
                            .logo{
                                width: 18%; 
                                padding: 0 2px;
                                border: thin solid black;
                            }
                            .address{
                                width: 48%;
                                border: thin solid black;
                                padding: 6px; 
                            }
                            .address span{
                                font-size: 10px;
                            }
                            .shipping{
                                width: 30%;
                                border: thin solid black;
                                padding: 6px; 
                            }
                            .shipping > span{
                                font-size: 9px;
                            }
                            .data_receipt{
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 2px;
                            }
                            .data_receipt td{
                                border: thin solid black;
                                width: 19%;
                                text-align: center;
                                font-size: 10px;
                                padding: 4px 0;
                            }
                            #receipt{
                                width: 24%;
                                font-size: 16px;
                                text-align: center;
                            }
                            .extensive_value{
                                width: 100%;
                                border-collapse: collapse;
                                margin: 3px 0;
                            }
                            .extensive_value td:first-child{
                                width: 8%;
                                border: thin solid black;
                                text-align: left; 
                                font-size: 10px;
                                padding: 4px 2px;
                            }
                            .extensive_value td:last-child{
                                width: 92%;
                                border: thin solid black;
                                text-align: left; 
                                padding: 4px 0 4px 60px;
                                font-size: 10px;
                            }
                            .client{
                                width: 100%;
                                border: thin solid black;
                                padding: 4px; 
                                margin-bottom: 3px;
                            }
                            .client td{
                                font-size: 10px;
                                padding: 6px 0;
                                border: 0;
                            }
                            .service{
                                width: 100%;
                                height: 450px; 
                                border-collapse: collapse;
                                font-size: 10px;
                            }
                            .service td{
                                text-align: center;
                                padding: 2px; 
                                border-left: thin solid black;
                                border-right: thin solid black;
                            }
                            #items_head{
                                height: 18px; 
                                border: thin solid black;
                            }
                            #items{
                                height: 8px; 
                            }
                            #total td{
                                padding: 8px 0; 
                                border: thin solid black;
                                height: 25px;
                            }
                            #total td:first-child{
                                border: 0;
                                text-align: right;
                                vertical-align: middle;
                                padding: 0 8px;
                            }
                            .message{
                                width: 100%;
                                border: thin solid black;
                                font-size: 7px;
                                padding: 3px;
                                margin-top: 3px;
                            }
                            .dashed{
                                width: 100%;
                                border: 1px dashed;
                                margin: 5px 0;
                            }
                            .signature{
                                width: 100%;
                                height: 60px; 
                                font-size: 7px;
                                border-collapse: collapse;
                            }
                            .signature td{
                                border: thin solid black;
                                padding: 2px;
                            }
                            .signature p, span{
                                text-align: left;
                            }
                        </style>

                    <main>
                        <div class="page">
                            <table class="company">
                                <td class="logo">
                                    <img t-if="doc.company_id.logo" t-attf-src="data:image/png;base64,#{doc.company_id.logo}" width="175"/>
                                </td>
                                <td style="width: 0,5%"/>
                                <td class="address">
                                    <h4 t-field="doc.company_id.name"/>
                                    <br/>
                                    <span t-field="doc.company_id.street_name"/>
,                                    <span t-field="doc.company_id.street_number"/>
 -                                    <span t-field="doc.company_id.district"/>
                                    <br/>

                                    <span>CEP: <span t-field="doc.company_id.zip"/>
 -                                    <span t-field="doc.company_id.city_id"/>
 -                                    <span t-field="doc.company_id.state_id.code"/>
                                </span>
                                <br/>
                                <br/>
                                <span>FONES: <span t-field="doc.company_id.phone"/>
                                </span>
                                <br/>
                                <br/>
                            </td>
                            <td style="width: 0,5%"/>
                            <td class="shipping">
                                <span>
                                    <h3>ORÇAMENTO Nº: <span t-field="doc.id"/>
                                    </h3>
                                </span>
                                <br/>
                                <h6>
                                    <span>CNPJ: <span t-field="doc.company_id.cnpj_cpf"/>
                                    </span>
                                </h6>
                                <h6>
                                    <span>Insc. Estadual: <span t-field="doc.company_id.inscr_est"/>
                                    </span>
                                </h6>
                                <br/>

                                <span>
                                    <h4>DATA DE EMISSÃO : <span t-field="doc.date_repair"/>
                                    </h4>
                                </span>
                            </td>
                        </table>

                        <table class="data_receipt">
                            <tr>
                                <td>Nº ORÇAMENTO</td>
                                <td>VALOR R$</td>
                                <td>COND. PAGAMENTO</td>
                                <td>VENCIMENTO</td>
                                <td rowspan="2" id="receipt">
                                    <strong>
                                        <span t-field="doc.name"/>
                                    </strong>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span t-field="doc.id"/>
                                </td>
                                <td>
                                    <span t-field="doc.amount_total"/>
                                </td>
                            </tr>
                        </table>
                        <table class="client">
                            <tr>
                                <td>CLIENTE: <span t-field="doc.partner_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>ENDEREÇO : <span t-field="doc.partner_id.street"/>
                                </td>
                                <td>BAIRRO : <span t-field="doc.partner_id.district"/>
                                </td>
                            </tr>
                            <tr>
                                <td>MUNICÍPIO : <span t-field="doc.partner_id.city_id"/>
                                </td>
                                <td>CEP : <span t-field="doc.partner_id.zip"/>
                                </td>
                                <td>ESTADO : <span t-field="doc.partner_id.state_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td>CNPJ / CPF : <span t-field="doc.partner_id.cnpj_cpf"/>
                                </td>
                                <td/>
                                <td>I.E. : <span t-field="doc.partner_id.inscr_est"/>
                                </td>
                            </tr>
                        </table>

                        <table class="service">
                            <tr id="items_head">
                                <td rowspan="2" style="width: 50%; vertical-align: middle;">DISCRIMINAÇÃO DOS PRODUTOS/SERVIÇOS</td>
                                <td rowspan="2" style="width: 10%; vertical-align: middle;">UNIDADE</td>
                                <td rowspan="2" style="width: 10%; vertical-align: middle;">QUANTIDADE</td>
                                <td colspan="2" style="width: 30%; vertical-align: middle;">PREÇO</td>
                            </tr>
                            <tr style="border-bottom: thin solid black; height: 10px">
                                <td style="width: 15%; vertical-align: middle;">UNITÁRIO</td>
                                <td style="width: 15%; vertical-align: middle;">TOTAL</td>
                            </tr>
                            <t t-foreach="doc.operations" t-as="line">
                                <tr id="items">
                                    <td>
                                        <span t-field="line.name"/>
                                    </td>
                                    <td>
                                        <span t-field="line.product_uom.code"/>
                                    </td>
                                    <td>
                                        <span t-field="line.product_uom_qty"/>
                                    </td>
                                    <td>
                                        <span t-field="line.price_unit"/>
                                    </td>
                                    <td>
                                        <span t-field="line.price_subtotal"/>
                                    </td>
                                </tr>
                            </t>

                            <tr style="border-bottom: thin solid black;">
                                <td/>
                                <td/>
                                <td>
                                    <span t-field="doc.quotation_notes"/>
                                </td>
                                <td/>
                                <td/>
                            </tr>
                            <tr id="total">
                                <td colspan="4">VALOR TOTAL</td>
                                <td>
                                    <span t-field="doc.amount_total"/>
                                </td>
                            </tr>
                        </table>

                        <div class="dashed"/>
                        <div style="margin-top: 35px; font-size: 8px; color: #5c5c5c">
                            <span>Powered By ATSTi Soluções - www.atsti.com.br</span>
                        </div>
                    </div>
                </main>
                </t>
            </t>
        </t>
    </t>
</template>
</odoo>