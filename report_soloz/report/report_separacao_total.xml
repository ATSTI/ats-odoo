        <t t-call="web.html_container">
            <div class="page">
                <div class="oe_structure"/>
                <br/>
                <table style="width:49%; height: 60px;float: left;">
                    <tr><td style="height: 30px"></td></tr>
                    <tr>
                        <td style="text-align: left; width:100%" >
                            <b style="font-size:18px" t-field="docs.company_id.name"/>                                
                            <br/> <span t-field="docs.company_id.street"/>, <span t-field="docs.company_id.street_number"/>
                            <br/> <span t-field="docs.company_id.district"/> - <span t-field="docs.company_id.city_id.name"/>;
                        </td>
                    </tr>
                </table>
                <table style="width:49%; height: 30px;text-align: right;">
                    <tr>
                        <td style="width:40%">
                            <div style="width: 100%;float: right;">
                                <img t-attf-src="data:image/*;base64,{{docs.company_id.logo}}"
                                    t-att-alt="docs.company_id.name" style="width:50%; height:50%"/>
                            </div>
                        </td>
                    </tr>
                </table>
                <br/><br/>
                <table style="border: 1px solid #dcdcdc; border-collapse: collapse; font-size:14px;width: 100%;">
                    <tr>
                        <td style="border: 1px solid #dcdcdc; height:27px; font-size:12px;text-align: left; width: 50%">
                            <b>Endereço do cliente</b>
                        </td>
                        <td style="border: 1px solid #dcdcdc; height:27px; font-size:12px;text-align: center; width: 20%">
                            <b>Pedido</b>
                        </td>
                        <td style="border: 1px solid #dcdcdc; height:27px; font-size:12px;text-align: center; width: 20%">
                            <b>Status</b>
                        </td>
                        <td style="border: 1px solid #dcdcdc; height:27px; font-size:12px;text-align: center; width: 20%">
                            <b>Data Prevista</b>
                        </td>
                    </tr>
                    <t t-foreach="docs" t-as="o">
                        <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
                        <tr>
                            <td style="border: 1px solid #dcdcdc; height:25px; font-size:12px;text-align: left;">
                                <div t-if="o.partner_id" name="partner_header">
                                <div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                                    <p/> CNPJ / CPF :  <span t-field="o.partner_id.cnpj_cpf"/>
                                </div>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:25px; font-size:12px;text-align: center;">
                               <div t-if="o.origin" class="col-auto" name="div_origin">
                                    <p t-field="o.origin"/>
                                </div>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:25px; font-size:12px;text-align: center;">
                                <div class="col-auto" name="div_state">
                                    <p t-field="o.state"/>
                                </div>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:25px; font-size:12px;text-align: center;">
                                <div class="col-auto" name="div_sched_date">
                                    <p t-field="o.scheduled_date"/>
                                </div>
                            </td>
                        </tr>
                    </t>
                </table>
