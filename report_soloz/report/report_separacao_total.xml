                <br/><br/>
                <t t-set="product" t-value="set()" />
                <t t-foreach="request.env['stock.move'].search([('picking_id', 'in', docs.mapped('id'))])" t-as="prod">
                    <t t-if="prod.product_id">
                        <t t-set="dummy" t-value="product.add(prod.product_id)" />
                    </t>
                </t>

                <table style="border: 1px solid #dcdcdc; border-collapse: collapse; font-size:14px;width: 100%;">
                    <tr>
                        <td style="border: 1px solid #dcdcdc; height:27px; font-size:12px;text-align: left; width: 50%">
                            <b>Produto</b>
                        </td>
                        <td style="border: 1px solid #dcdcdc; height:27px; font-size:12px;text-align: center; width: 20%">
                            <b>Demanda</b>
                        </td>
                        <td style="border: 1px solid #dcdcdc; height:27px; font-size:12px;text-align: center; width: 20%">
                            <b>De</b>
                        </td>
                    </tr>

                    <t t-set="valores" t-value="[]" />
                    <t t-foreach="product" t-as="p">
                        <t t-set="qtd" t-value="0" />
                        <t t-set="value" t-value="0" />
                        <t t-set="locations" t-value="set()" />

                        <t t-foreach="request.env['stock.move'].search([('picking_id', 'in', docs.mapped('id')), ('product_id', '=', p.id)])" t-as="mv_line">
                            <t t-set="qtd" t-value="qtd + mv_line.product_uom_qty" />
                            <t t-set="value" t-value="value + (mv_line.product_uom_qty * mv_line.price_unit if mv_line.price_unit else 0)" />
                            <t t-if="mv_line.location_id">
                                <t t-set="dummy" t-value="locations.add(mv_line.location_id.display_name)" />
                            </t>
                        </t>

                        <t t-set="valores" t-value="valores + [value]" />

                        <tr>
                            <td style="border: 1px solid #dcdcdc; height:25px; font-size:12px;text-align: left;">
                                <t t-esc="p.name"/>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:25px; font-size:12px;text-align: center;">
                                <span t-esc="qtd"/>
                            </td>
                            <td style="border: 1px solid #dcdcdc; height:25px; font-size:12px;text-align: center;">
                                <t t-foreach="locations" t-as="loc" t-separator=", ">
                                    <t t-esc="loc"/>
                                </t>
                            </td>
                        </tr>
                    </t>

                    <t t-set="value_t" t-value="sum(valores)" />
                    <!-- <tr>
