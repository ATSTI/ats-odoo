<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_tree_inherit_city_state" model="ir.ui.view">
        <field name="name">sale.order.tree.city.state.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_city" string="Cidade"/>
                <field name="partner_state_id" string="Estado"/>
            </xpath>

        </field>
    </record>

</odoo>