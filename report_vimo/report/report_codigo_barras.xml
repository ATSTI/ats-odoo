<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_codigo_barras" name="Etiquetas de Código de Barras Vimo">
        <t t-call="web.basic_layout">
            <div class="page" style="box-sizing:border-box; text-align:center; align-items:center;">

                <style>
                    .container-etiquetas {
                        width: 22cm;
                        margin: 0 auto;
                        text-align: left;
                        font-size: 0;
                    }

                    .etiqueta {
                        display: inline-block;
                        width: 4.1cm;
                        height: 2.35cm;
                        margin-right: 2.9mm;
                        margin-top: 0.1mm;
                        padding: 1px;
                        overflow: hidden;
                        vertical-align: top;
                        font-size: initial;
                        text-align: center;
                    }

                    .etiqueta-nome {
                        font-size: 9px;
                        font-weight: bold;
                        text-transform: uppercase;
                        line-height: 7px;
                        height: 7px;
                        overflow: hidden;
                        margin: 0;
                        padding: 0;
                        white-space: nowrap;
                    }

                    .etiqueta-preco {
                        font-size: 10px;
                        font-weight: bold;
                        margin: 0;
                        padding: 0;
                        line-height: 7px;
                        height: 7px;
                    }

                    .etiqueta-barcode-text {
                        font-size: 9px;
                        font-weight: bold;
                        text-align: center;
                        margin-top: 3px;
                        padding: 0;
                        line-height: 6px;
                        height: 6px;
                    }

                    table {
                        border: 0 !important;
                        border-collapse: collapse !important;
                    }
                    table td, table th {
                        border: 0 !important;
                        padding: 0;
                        margin: 0;
                    }

                    .page-break {
                        page-break-after: always;
                    }
                </style>

                <div class="container-etiquetas">

                    <t t-set="contador_etiquetas" t-value="0"/>

                    <t t-foreach="docs" t-as="picking">
                        <t t-foreach="picking.move_lines" t-as="move">

                            <t t-set="qty" t-value="int(move.product_uom_qty)"/>

                            <t t-set="nome_produto"
                               t-value="move.product_id.display_name.split('] ')[1]
                                       if ']' in move.product_id.display_name
                                       else move.product_id.display_name"/>

                            <t t-foreach="range(qty)" t-as="item">

                                <t t-set="contador_etiquetas" t-value="contador_etiquetas + 1"/>

                                <div class="etiqueta">

                                    <table style="width:100%; height:100%;">

                                        <tr style="height:7px;">
                                            <td>
                                                <div class="etiqueta-nome">
                                                    <span t-esc="nome_produto"/>
                                                </div>

                                                <div class="etiqueta-preco" style="padding-bottom:1px; margin-bottom:2px;">
                                                    R$ <span t-esc="'%.2f' % move.product_id.list_price"/>
                                                </div>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td class="text-center">

                                                <!-- Produto com lote -->
                                                <t t-if="move.product_id.tracking != 'none'">
                                                    <t t-if="move.lot_ids">
                                                        <img
                                                            t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s'
                                                            % ('Code128', move.lot_ids[0].name, 600, 150)"
                                                            style="width:3cm; height:0.9cm;"
                                                            alt="Barcode"/>

                                                        <div class="etiqueta-barcode-text">
                                                            <span t-esc="move.lot_ids[0].name"/>
                                                        </div>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="text-muted">Sem lote</span>
                                                    </t>
                                                </t>

                                                <!-- Produto sem lote -->
                                                <t t-if="move.product_id.tracking == 'none'">
                                                    <t t-if="move.product_id.barcode">
                                                        <img
                                                            t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s'
                                                            % ('Code128', move.product_id.barcode, 600, 150)"
                                                            style="width:3cm; height:0.9cm;"
                                                            alt="Barcode"/>

                                                        <div class="etiqueta-barcode-text">
                                                            <span t-esc="move.product_id.barcode"/>
                                                        </div>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="text-muted">Sem código</span>
                                                    </t>
                                                </t>

                                            </td>
                                        </tr>

                                    </table>

                                </div>

                                <t t-if="contador_etiquetas % 65 == 0">
                                    <div class="page-break"></div>
                                </t>

                            </t>

                        </t>
                    </t>

                </div>

            </div>
        </t>
    </template>
</odoo>
