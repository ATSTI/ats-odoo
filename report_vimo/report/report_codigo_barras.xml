<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_codigo_barras">
            <t t-call="web.basic_layout">
                <div class="page">
                    <t t-foreach="docs" t-as="picking">
                        <t t-foreach="picking.move_lines" t-as="move">
                            <t t-set="qty" t-value="int(move.product_uom_qty)"/>
                            <t t-foreach="range(qty)" t-as="item">
                                <t t-translation="off">

                                    <div style="display: inline-table; height: 4rem; width: 13%;">
                                        <table class="table table-bordered" style="border: 2px solid black;">

                                            <tr>
                                                <th class="table-active text-left" style="height:4rem;">
                                                    <span t-esc="move.product_id.display_name"/> <br/>
                                                    <strong>R$ <span t-esc="move.product_id.list_price"/></strong>
                                                </th>
                                            </tr>

                                            <t t-if="move.product_id.tracking != 'none'">
                                                <tr>
                                                    <td class="text-center align-middle">
                                                        <t t-set="lot_name"
                                                           t-value="move.move_line_ids and (move.move_line_ids[0].lot_name or move.move_line_ids[0].lot_id.name)"/>

                                                        <t t-if="lot_name">
                                                            <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' %
                                                                            ('Code128', lot_name, 600, 150)"
                                                                 style="width:100%;height:4rem" />
                                                            <span t-esc="lot_name"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="text-muted">No barcode available</span>
                                                        </t>

                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="move.product_id.tracking == 'none'">
                                                <tr>
                                                    <td class="text-center align-middle" style="height: 6rem;">
                                                        <t t-if="move.product_id.barcode">
                                                            <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' %
                                                                                ('Code128', move.product_id.barcode, 600, 150)"
                                                                 style="width:100%;height:4rem"/>
                                                            <span t-esc="move.product_id.barcode"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="text-muted">No barcode available</span>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </table>
                                    </div>

                                </t>
                            </t>
                        </t>
                    </t>
                </div>
            </t>
        </template>

    </data>
</odoo>
