<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_repair_order_form" model="ir.ui.view">
            <field name="name">repair.order.form</field>
            <field name="model">repair.order</field>
            <field name="inherit_id" ref="repair.view_repair_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/notebook" position="inside">
                    <page string="Requisição de Materiais">
                        <group string="Itens Solicitados">
                            <field name="material_request_line_ids">
                                <tree editable="bottom" delete="true">
                                    <field name="item" width="300"/>
                                    <field name="quantidade" width="80"/>
                                    <field name="obs" width="400"/>
                                    <field name="who_req" width="300"/>
                                    <field name="date_req" width="200"/>
                                </tree>
                            </field>
                        </group>
                        <group string="Devoluções">
                            <field name="material_devolution_line_ids">
                                <tree editable="bottom" delete="true">
                                    <field name="item" width="300"/>
                                    <field name="quantidade" width="80"/>
                                    <field name="obs" width="400"/>
                                    <field name="who_devol" width="300"/>
                                    <field name="date_devol" width="200"/>
                                </tree>
                            </field>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
