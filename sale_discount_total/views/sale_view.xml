<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="sale_discount_value_view_form" model="ir.ui.view">
            <field name="name">sale.discount.value.view.form</field>
            <field name="model">sale.order</field>
            <field name="priority">999</field>
            <field name="inherit_id" ref="l10n_br_sale.l10n_br_sale_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="before">
                    <button string="Approve" type="object" name="action_approve" states="waiting" class="oe_highlight"
                            groups="sales_team.group_sale_manager"/>
                </xpath>
                <xpath expr="//button[@name='action_cancel']" position="attributes">
                    <attribute name="states">draft,sent,sale,waiting</attribute>
                </xpath>
                <!-- <field name="discount_rate" position="replace">
                    <field name="discount_rate" readonly="1" />
                </field> -->
                <!-- <xpath expr="//field[@name='amount_price_gross']" position="attributes">
                    <attribute name="invisible">False</attribute>
                </xpath> -->
                    <!-- <xpath expr="//field[@name='amount_price_gross']" position="replace">
                    <field name="amount_price_gross" invisible='False'/>
                    </xpath> -->
                <xpath
                    expr="//field[@name='order_line']/form//label[@for='name']"
                    position="before"
                >
                    <notebook attrs="{'invisible': ['|', ('display_type', '!=', False), ('parent.fiscal_operation_id', '=', True)]}">
                        <page name="amounts" string="Totais">
                            <group>
                                <group>
                                </group>
                                <group>
                                    <field name="amount_total" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </xpath>
                <xpath expr="//field[@name='state']" position="before">
                    <button string="Approve" type="object" name="action_approve" states="waiting" class="oe_highlight"
                            groups="sales_team.group_sale_manager"/>
                </xpath>
                <xpath expr="//button[@name='action_cancel']" position="attributes">
                    <attribute name="states">draft,sent,sale,waiting</attribute>
                </xpath>
                <!-- <field name="note" position="before">
                    <group name="discount" colspan="2">
                        <field name="discount_type"/>
                        <field name="discount_rate_t"/>
                    </group>                    
                </field>                 -->
                <xpath expr="//group[@name='note_group']" position="replace">
                    <group name="note_group" col="6">
                        <group name="discount" colspan="3">
                            <field name="discount_type"/>
                            <label for="discount_rate_t" />
                            <div class="o_row">
                                <field name="discount_rate_t"/>
                                <button name="button_dummy"
                                            states="draft,sent" string="Atualizar" type="object"
                                            class="oe_edit_only btn-primary"/>
                            </div>
                            <field name="discount_rate" string="Percentual" readonly="1" />
                        </group>

                        <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                            <field name="amount_price_gross" />
                            <!-- <field name="amount_discount" widget='monetary'
                                   options="{'currency_field': 'currency_id'}"/> -->
                            <field name="amount_untaxed" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_tax" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                            <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                <label for="amount_total"/>
                            </div>
                            <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator"
                                   widget='monetary' options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group colspan="4">
                            <field name="note" nolabel="1" placeholder="Terms and conditions..."/>
                        </group>
                        <div class="oe_clear"/>
                    </group>

                </xpath>
                <field name="discount_value" position="replace">
                    <field name="discount_value" string="Desconto valor" />
                    <field name="discount_type" />
                    <field name="discount_rate_t" />
                    <button name="button_update_discount"
                                            states="draft,sent" string="Atualizar" type="object"
                                            class="oe_edit_only btn-primary"/>
                </field>
                <!-- Roundoff the discount field -->
                <!-- <xpath expr="//field[@name='order_line']/tree/field[@name='discount']" position="attributes">
                    <attribute name="digits">[16, 2]</attribute>
                </xpath> -->
            </field>
        </record>
</odoo>
