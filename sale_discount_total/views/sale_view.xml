<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="sale_discount_value_view_form" model="ir.ui.view">
            <field name="name">sale.discount.value.view.form</field>
            <field name="model">sale.order</field>
            <field name="priority">99</field>
            <field name="inherit_id" ref="l10n_br_sale.l10n_br_sale_order_form"/>
            <field name="arch" type="xml">
                <field name="discount_rate" position="replace">
                    <field name="discount_rate" string="Percentual" invisible="1" />
                </field>
                <field name="note" position="before">
                    <group name="discount" colspan="3">
                        <field name="discount_type"/>
                        <label for="discount_rate_t" />
                        <div class="o_row">
                            <field name="discount_rate_t"/>
                            <button name="button_dummy"
                                states="draft,sent" string="Atualizar" type="object"
                                class="oe_edit_only btn-primary"/>
                        </div>
                    </group>
                </field>
                <field name="amount_price_gross" position="replace">
                    <field
                        name="amount_price_gross"
                        widget='monetary'
                        options="{'currency_field': 'currency_id'}"
                    />
                </field>
                <field name="discount_value" position="after">
                    <group>
                        <field name="discount_type" />
                        <field name="discount_rate_t" />
                        <button name="button_update_discount"
                            states="draft,sent" string="Atualizar" type="object"
                            class="oe_edit_only btn-primary"/>
                    </group>
                    <group>
                        <field name="amount_total" />
                    </group>
                </field>
            </field>
        </record>
</odoo>