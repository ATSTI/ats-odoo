<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_floor_price_product_normal_form_view" model="ir.ui.view">
            <field name="name">product.normal.form.floor_price</field>
            <field name="model">product.template</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <field name="list_price" position="after">
                    <field name="floor_price_limit" widget='monetary' groups="sales_team.group_sale_manager"/>
                </field>
                <label for="standard_price" position="replace">
                    <label for="standard_price" groups="!account_move.grupo_permissao_especifica"/>
                </label>
                <div name="standard_price_uom" position="replace">
                    <div name="standard_price_uom" groups="!account_move.grupo_permissao_especifica">
                        <field name="standard_price" widget="monetary" options="{'currency_field': 'cost_currency_id'}"/>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>
