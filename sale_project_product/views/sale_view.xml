<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_invoice_policy_inherit_sale_project_product" model="ir.ui.view">
        <field name="name">product.template.inherit.sale.projectform</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_project.product_template_form_view_invoice_policy_inherit_sale_project"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='service_tracking']" position="replace">
                <field name="service_tracking"/>
            </xpath>
        </field>
    </record>

    <record id="saleorder_tree_view_project" model="ir.ui.view">
        <field name="name">saleorder.tree.view.project</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="task_stage"/>
                <field name="libera" widget="boolean_toggle" string="Entrega Liberada"/>
            </xpath>
        </field>
    </record>
    
    <record id="saleorder_form_view_project" model="ir.ui.view">
        <field name="name">saleorder.form.view.project</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="task_stage" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='ind_pres']" position="after">
                <field name="libera"/>
            </xpath>
        </field>
    </record>

</odoo>
