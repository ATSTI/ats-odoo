<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_tree_view_project" model="ir.ui.view">
        <field name="name">stock.tree.view.project</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="entrega_liberada_stock" widget="boolean_toggle" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="status_tarefa" optional="show" />
            </xpath>
        </field>
    </record>
    
    <record id="stock_form_view_project" model="ir.ui.view">
        <field name="name">stock.form.view.project</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="before">
                <field name="entrega_liberada_stock" invisible="1"/>
                <field name="status_tarefa" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_chama_taks" class="oe_stat_button" icon="fa-tasks" attrs="{'invisible': [('tasks_count_stock', '=', 0)]}" groups="project.group_project_user">
                    <field name="tasks_count_stock" widget="statinfo" string="Tarefas"/>
                </button>
                <button class="oe_stat_button" name="action_chama_mrp" type="object" icon="fa-wrench" attrs="{'invisible': [('mrp_production_count_stock', '=', 0)]}" groups="mrp.group_mrp_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="mrp_production_count_stock"/></span>
                        <span class="o_stat_text">Fabricação</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>