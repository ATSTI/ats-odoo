<odoo>
    <record id="module_shopee_category" model="ir.module.category">
        <field name="name">Shopee</field>
        <field name="sequence">17</field>
    </record>
    <record id="shopee_group_user" model="res.groups">
        <field name="name">Shopee usuario</field>
        <field name="category_id" ref="module_shopee_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="shopee_group_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="implied_ids" eval="[(4, ref('shopee_group_user'))]"/>
        <field name="category_id" ref="module_shopee_category"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
