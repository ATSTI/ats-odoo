<?xml version="1.0"?>
<odoo>
    <data>
        <record id="product_shopee_form" model="ir.ui.view">
            <field name="name">product_shopee.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view" />
            <field name="priority">999</field>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='purchase']" position="after">
                    <page name="shopee_page" string="Shopee">
                        <group>
                            <group>
                                <field name="shopee" />
                                <field name="shopee_config_id" attrs="{'invisible': [('shopee', '=', False)]}"/>
                                <!-- <field name="margin_shopee" attrs="{'invisible': [('shopee', '=', False)]}"/> -->
                            </group>
                            <div>
                                <group>
                                    <field name="title_shopee" attrs="{'invisible': [('shopee', '=', False)]}"/>
                                    <field name="price_shopee" attrs="{'invisible': [('shopee', '=', False)]}"/>
                                    <button name="atualiza_preco_shopee" string="Atualizar Preço" type="object" class="btn btn-primary" attrs="{'invisible': [('shopee', '=', False)]}"/>
                                    <field name="qtd_shopee" attrs="{'invisible': [('shopee', '=', False)]}"/>
                                    <button name="atualiza_stock_shopee" string="Atualizar Quantidade" type="object" class="btn btn-primary" attrs="{'invisible': [('shopee', '=', False)]}"/>
                                    <!-- <field name="guarantee_shopee" attrs="{'invisible': [('shopee', '=', False)]}"/> -->
                                    <field name="shopee_sku" attrs="{'invisible': [('shopee', '=', False)]}"/>
                                </group>
                            </div>
                            <group>
                                <!-- <button name="action_envia_produto_shopee" string="Enviar Produto Para Shopee" type="object" class="btn btn-primary" attrs="{'invisible': [('shopee', '=', False)]}"/> -->
                                <field name="shopee_item_id" attrs="{'invisible': [('shopee', '=', False)]}" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
