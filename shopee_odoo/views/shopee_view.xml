<?xml version="1.0"?>
<odoo>
    <data>
        <record id="shopee_config_form_view" model="ir.ui.view">
            <field name="name">shopee.config.form</field>
            <field name="model">shopee.config</field>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <form string="Shopee Configurações">
                    <header>
                        <button name="action_pega_faturas_shopee" string="Sincronizar Faturas Shopee" type="object" class="btn btn-primary" groups="base.group_no_one"/>
                        <button name="envia_xml_shopee" string="Enviar XML's Para Shopee" type="object" class="btn btn-primary" groups="base.group_no_one"/>
                        <button name="action_gera_acess_token" string="Gerar Access Token" type="object" class="btn btn-primary" groups="base.group_no_one"/>
                    </header>
                    <sheet>
                        <group>
                            <!-- Informações principais -->
                            <group colspan="4" string="Informações Principais">
                                <field name="name" colspan="2"/>
                                <field name="shop_real" groups="base.group_no_one"/>
                                <field name="shopee_id" groups="base.group_no_one"/>
                                <field name="shopee_partner_id" groups="base.group_no_one"/>
                                <field name="shopee_partner_key" groups="base.group_no_one"/>
                            </group>

                            <!-- Tokens e segurança -->
                            <group colspan="4" string="Tokens e Segurança" groups="base.group_no_one">
                                <field name="refresh_token_security" invisible="1"/>
                                <field name="refresh_token" groups="base.group_no_one"/>
                                <field name="access_token" groups="base.group_no_one"/>
                                <field name="expire_date_token" groups="base.group_no_one"/>
                            </group>

                            <!-- Informações de preço de venda -->
                            <group colspan="3" string="Informações do Preço de Venda">
                                <field name="margin_shopee"/>
                                <field name="taxa_shopee"/>
                                <field name="margem_lucro"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="shopee_config_tree_view" model="ir.ui.view">
            <field name="name">shopee.config.tree</field>
            <field name="model">shopee.config</field>
            <field eval="7" name="priority"/>
            <field name="arch" type="xml">
                <tree string="Contas Shopee">
                    <field name="name"/>
                    <field name="shopee_id"/>
                </tree>
            </field>
        </record>

        <record id="action_config_shopee" model="ir.actions.act_window">
            <field name="name">Config Shopee</field>
            <field name="res_model">shopee.config</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="shopee_config_menu"
            name="Configurações Shopee"
            parent="sale.menu_sale_config"
            groups="shopee_group_user,shopee_group_manager"
            sequence="20"
            action="action_config_shopee"
        />
    </data>
</odoo>
