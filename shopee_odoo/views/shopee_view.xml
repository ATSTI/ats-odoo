<?xml version="1.0"?>
<odoo>
    <data>
        <record id="shopee_config_form_view" model="ir.ui.view">
            <field name="name">shopee.config.form</field>
            <field name="model">shopee.config</field>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <form string="Shopee Configurações">
                    <header>
                        <button name="action_pega_faturas_shopee" string="Sincronizar Faturas Shopee" type="object" class="btn btn-primary"/>
                        <button name="action_gera_acess_token" string="Gerar Access Token" type="object" class="btn btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="shop_real" />
                                <field name="shopee_id"/>
                                <field name="shopee_partner_id"/>
                                <field name="shopee_partner_key"/>
                                <!-- <button name="action_pega_faturas_shopee" string="Sincronizar Faturas Shopee" type="object" class="btn btn-primary"/> -->
                            </group>
                            <group>
                                <div class="o_row">
                                    <group>
                                        <field name="refresh_token_security" invisible='1'/>
                                        <field name="refresh_token"/>
                                        <!-- <button name="action_gera_acess_token" string="Gerar Access Token" type="object" class="btn btn-primary"/> -->
                                        <field name="access_token"/>
                                        <field name="expire_date_token" />
                                    </group>
                                </div>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="shopee_config_tree_view" model="ir.ui.view">
            <field name="name">shopee.config.tree</field>
            <field name="model">shopee.config</field>
            <field eval="7" name="priority"/>
            <field name="arch" type="xml">
                <tree string="Contas Shopee">
                    <field name="name"/>
                    <field name="shopee_id"/>
                </tree>
            </field>
        </record>

        <record id="action_config_shopee" model="ir.actions.act_window">
            <field name="name">Config Shopee</field>
            <field name="res_model">shopee.config</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="shopee_config_menu"
            name="Configurações Shopee"
            parent="sale.menu_sale_config"
            groups="shopee_group_user,shopee_group_manager"
            sequence="20"
            action="action_config_shopee"
        />
    </data>
</odoo>
