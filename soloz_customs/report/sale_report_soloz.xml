<?xml version="1.0" encoding="utf-8" ?>
<!-- oca-hooks:disable=file-not-used -->
<odoo>

    <template
        id="report_saleorder_document_custom_soloz"
        inherit_id="sale.report_saleorder_document"
        priority="99"
    >
        <xpath expr="//td[@name='td_subtotal']" position="replace">
            <td t-if="not line.display_type and not line.is_downpayment" name="td_subtotal" class="text-end o_price_total">
                <span t-field="line.amount_fiscal" groups="account.group_show_line_subtotals_tax_excluded"/>
                <span t-field="line.amount_fiscal" groups="account.group_show_line_subtotals_tax_included"/>
            </td>
        </xpath>

        <xpath expr="//td[@name='td_section_subtotal']" position="replace">
          <td name="td_section_subtotal" colspan="99">
              <strong class="mr16">Subtotal</strong>
      
              <t t-if="line_last">
                  <span t-out="doc.amount_price_gross" t-options="{'widget':'monetary','display_currency': doc.pricelist_id.currency_id}"/>
              </t>
      
              <t t-else="">
                  <span t-out="0.0" t-options="{'widget':'monetary','display_currency': doc.pricelist_id.currency_id}"/>
              </t>
          </td>
        </xpath>

        <xpath expr="//td[@name='td_section_subtotal']" position="replace">
            <td name="td_section_subtotal" colspan="99">
                <strong class="mr16">Subtotal</strong>
                <span t-out="doc.amount_price_gross" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
            </td>
        </xpath>

        <xpath expr="//div[@name='total']//table" position="replace">
            <table class="table table-sm table-borderless">
                <!-- carregar estrutura de impostos -->
                <t t-set="tax_totals" t-value="doc.tax_totals"/>
                <!-- Subtotal -->
                <t t-if="tax_totals.get('subtotals')">&gt;
                  <tr>
                      <td style="border-top:1px solid #999;">
                          <strong>
                              <span t-esc="tax_totals['subtotals'][0]['name']"/>
                          </strong>
                      </td>
                      <td style="text-align: right; border-top:1px solid #999;">
                      <span t-esc="tax_totals['subtotals'][0]['formatted_amount']"/>
                      </td>
                  </tr>
                </t>
                <!-- Impostos -->
                <t t-foreach="tax_totals['groups_by_subtotal']['Valor Sem Impostos']" t-as="tax">
                    <tr>
                        <t t-if="tax_index == 0">
                        <td style="border-top:1px solid #999;">
                            <span t-esc="tax['tax_group_name']"/>
                        </td>
                        <td style="background-color: #f2f2f2; border-top:1px solid #999; text-align: right">
                            <span t-esc="tax['formatted_tax_group_amount']"/>
                        </td>
                        </t>
                        <t t-else="">
                        <td>
                            <span t-esc="tax['tax_group_name']"/>
                        </td>
                        <td style="background-color: #f2f2f2; text-align: right">
                            <span t-esc="tax['formatted_tax_group_amount']"/>
                        </td>
                        </t>
                    </tr>
                </t>
                <!-- Total -->
                <tr>
                    <td style="font-weight:bold;">Total</td>
                    <td class="text-end" style="text-align: right; font-weight:bold;">
                        <span t-esc="doc.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                    </td>
                </tr>
            </table>
        </xpath>
    </template>

</odoo>