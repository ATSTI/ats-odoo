<?xml version="1.0"?>
<odoo>

    <record id="view_res_partner_soloz_custom_form" model="ir.ui.view">
        <field name="name">res.partner.custom.soloz</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <field name="user_id" position="before">
                <field name="readonly_user_id" invisible="1"/>
            </field>
            <field name="user_id" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
                <attribute name="attrs">{'readonly': [('readonly_user_id', '=', True)]}</attribute>
            </field>
        </field>
    </record>

</odoo>
