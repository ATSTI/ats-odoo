<?xml version="1.0"?>
<odoo>

    <record id="view_sale_order_soloz_form" model="ir.ui.view">
        <field name="name">sale.order.soloz</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_task" type="object" string="Criar Tarefa" class="btn-primary" data-hotkey="q" attrs="{'invisible': ['|', ('state', '!=', 'sale'), ('tasks_count', '>=', 1)]}"/>
            </xpath>
            <field name="partner_id" position="after">
                <field name="contact_partner" widget="many2many_tags" options="{'color_field': 'color'}" invisible="1"/>
                <field name="tasks_count" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_sale_order_soloz_tree" model="ir.ui.view">
        <field name="name">sale.order.tree.soloz</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="contact_partner_names" optional="show"/>
                <field name="partner_city" string="Cidade"/>
                <field name="partner_state_id" string="Estado"/>
            </field>
            <xpath expr="//field[@name='invoice_status']" position="before">
                <field name="task_stage" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_quotation_soloz_tree" model="ir.ui.view">
        <field name="name">sale.order.quotation.tree.soloz</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contact_partner_names" />
                <field name="partner_city" string="Cidade"/>
                <field name="partner_state_id" string="Estado"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="task_stage" optional="show"/>
            </xpath>
        </field>
    </record>


</odoo>
