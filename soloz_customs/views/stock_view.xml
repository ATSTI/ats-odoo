<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_tree_view_status" model="ir.ui.view">
        <field name="name">stock.tree.view.project</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="status_tarefa" optional="show" />
            </xpath>
        </field>
    </record>
    
    <record id="stock_form_view_status" model="ir.ui.view">
        <field name="name">stock.form.view.project</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="before">
                <field name="status_tarefa" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>