<odoo>
    <record id="view_helpdesk_ticket_form_inherit_close" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.close</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='assign_to_me']" position="after">
                <button name="action_close_ticket"
                        type="object"
                        string="Encerrar Ticket"
                        class="oe_highlight"/>
            </xpath>
            <xpath expr="//header/button[@name='assign_to_me']" position="replace">
                <button name="assign_to_me"
                        type="object"
                        string="Atribuir a mim"/>
            </xpath>

        </field>
    </record>
</odoo>
